//@version=6
// Independent experimental reconstruction from observable behavior and the supplied manual.
// NOT original ManipulationX source. NOT verified equivalent. See README-replica.md.
// Option 1: R = eligible sweep + LTF inversion; linked HTF origin upgrades R+.
// C = prior direction + available DOL + fresh 5m/15m retest + LTF inversion.
// Adjustable conventions remain experimental; filters do not define base R.
indicator("Liquidity Inversion Lab [experimental 0.28 EN]", "LI Lab 0.28 EN", overlay=true, max_boxes_count=250, max_lines_count=450, max_labels_count=500)

// 0.28: a 5000-bar buffer only for the series f_lrl scans with a dynamic offset,
// instead of a global max_bars_back that sized every series in the script.
max_bars_back(high, 5000)
max_bars_back(low, 5000)

string Q = "👁 00 ━ QUICK VIEW · SHOW / HIDE"
string R = "🔄 01A ━ R / R+ SETUP · REVERSAL"
string C = "➡️ 01B ━ C SETUP · CONTINUATION"
string F = "🎯 01C ━ FILTERS AND CONFIRMATION"
string S = "🎨 01D ━ SIGNAL APPEARANCE"
string G2 = "🧩 02 ━ CHART FVG / iFVG"
string G3 = "💧 03A ━ SWING LIQUIDITY · $$$ / SWP"
string G4 = "🕒 04 ━ HTF ZONES · 15m / 1h / 4h"
string G5 = "🌍 05A ━ SESSION WINDOWS · KILL ZONES"
string G6 = "📊 06 ━ CONFLUENCE PANEL"
string G7 = "🏷 07A ━ LABEL SPACING · SHARED DEFAULTS"
string G3E = "💧 03B ━ EQUAL HIGHS / LOWS"
string G3L = "📐 03C ━ LRL · TRENDLINE LIQUIDITY"
string G5A = "🌏 05B ━ ASIA LEVELS"
string G5L = "🌍 05C ━ LONDON LEVELS"
string G5N = "🗽 05D ━ NEW YORK LEVELS"
string G5S = "🔗 05E ━ SMT · CORRELATED PIVOTS"
string G7D = "☀ 07B ━ DAILY OPEN"
string G7W = "📅 07C ━ WEEKLY OPEN"
string G7M = "🗓 07D ━ MONTHLY OPEN"
string G7P = "↩ 07E ━ PREVIOUS PERIOD LEVELS"
string G78 = "🕗 07F ━ 8AM CANDLE RANGE"
string G79 = "🕘 07G ━ 9AM CANDLE RANGE"

string appearanceMode = input.string("Custom", "Appearance preset", options=["Minimal", "Custom"], group=Q, tooltip="Minimal uses plain text for every label. Select Custom to choose separate shapes for R, R+, C, sessions, liquidity, LRL, references. Older history markers remain plain text with fixed directional colors to respect the plot budget. Display only; detection and alerts are unchanged.")
bool signalsOn = input.bool(true, "Show signals", group=Q, tooltip="Show or hide R/R+/C without changing calculations. Guide: 00 visibility; 01A R, 01B C, 01C filters, 01D appearance; 02 chart FVG; 03 liquidity/LRL; 04 HTF FVG; 05 sessions/SMT; 06 panel; 07 levels and labels. TradingView does not support buttons that jump between settings groups.")
bool showIFVG = input.bool(true, "Show chart FVG/iFVG", group=Q, tooltip="Display zones from the chart timeframe. Signal calculations are independent.")
bool showLiquidity = input.bool(true, "Show BSL/SSL liquidity", group=Q, tooltip="Display significant swing levels with horizontal lines.")
bool showEqual = input.bool(true, "Show equal highs/lows", group=Q, tooltip="Draw approximate EQH/EQL from confirmed swings.")
bool showLRL = input.bool(true, "Show LRL lines", group=Q, tooltip="Visual control only. LRL formation and alerts are still calculated when lines are hidden.")
bool htfOn = input.bool(true, "Show HTF FVG zones", group=Q, tooltip="Master display switch for HTF boxes. Contact calculations remain independent.")
bool showSMT = input.bool(true, "Show SMT", group=Q, tooltip="Display confirmed pivot divergences against the correlated symbol.")
bool showChecklist = input.bool(false, "Show confluence panel", group=Q, tooltip="Display the checklist for the latest signal or the selected bar.")
bool watermarkOn = input.bool(true, "Show LI Lab watermark", group=Q, tooltip="Small identifier showing LI Lab and the chart timeframe.")
bool showLevelTags = input.bool(true, "Show level labels", group=Q, tooltip="Master switch for line and reference labels.")
bool reversalsOn = input.bool(true, "Enable R/R+ reversals", group=R, tooltip="Enable the laboratory reversal models.")
bool reversal4h = input.bool(true, "Include 4h FVG in R+", group=R, active=reversalsOn, tooltip="Link R+ to a valid 4h zone at the sweep extreme, even when its boxes are hidden. An unrelated earlier HTF contact does not qualify.")
bool shortPivotR = input.bool(true, "Allow short pivots as R levels", group=R, active=reversalsOn, tooltip="Add short signal pivots to eligible reversal levels. Enabled by default to preserve the user's matched comparison profile. Disable to restrict R to liquidity swings, EQH/EQL, sessions, prior-day and premarket levels.")
bool onlyA = input.bool(false, "R: require HTF delivery", group=R, active=reversalsOn, tooltip="Only allow reversals linked to an HTF FVG at the sweep. R+ does not represent a validated probability.")
int setupTTL = input.int(20, "Reversal setup expiry · bars", minval=1, maxval=200, group=R, active=reversalsOn, tooltip="Maximum bars after the sweep to confirm a reversal.")
bool continuationsOn = input.bool(true, "Enable C continuations", group=C, tooltip="C requires a prior direction, available DOL, a 5m/15m FVG retracement and inversion of the pullback LTF FVG. Calculated on 30s–3m charts. Bar-count settings use chart candles: the same count covers half the time on 30s compared with 1m.")
bool continuation5m = input.bool(true, "C from 5m FVG", group=C, active=continuationsOn, tooltip="Enable 5m points of interest aligned with the prior direction.")
bool continuation15m = input.bool(true, "C from 15m FVG", group=C, active=continuationsOn, tooltip="Enable 15m points of interest. Prefer 15m if both layers qualify on the same bar.")
string continuationTrendMode = input.string("Confirmed structure", "C prior direction", options=["Confirmed structure", "Manual bias"], group=C, active=continuationsOn, tooltip="Structure uses the latest close above/below a confirmed liquidity swing. Manual bias uses the daily Bullish/Bearish setting; Neutral does not enable C. This is a testable convention, not the author's certified formula.")
int continuationAge = input.int(12, "C FVG maximum age · source bars", minval=1, maxval=200, group=C, active=continuationsOn, tooltip="Adjustable fresh-zone convention: 12 bars of the 5m/15m source timeframe. Not an author-certified threshold.")
int continuationTTL = input.int(20, "C pullback expiry · LTF bars", minval=1, maxval=200, group=C, active=continuationsOn, tooltip="Maximum time between POI retest and iFVG confirmation. Cancel C if the zone breaks, direction changes or no DOL remains.")
string modelPriority = input.string("R first", "When R and C overlap", options=["R first", "C first", "Skip overlap"], group=F, tooltip="Explicit laboratory convention for a close that qualifies for both models. The original script's priority has not been confirmed.")
string biasInput = input.string("Neutral", "Manual daily bias", options=["Neutral", "Bullish", "Bearish"], group=F, tooltip="Neutral allows both directions; Bullish/Bearish restrict signals to the chosen direction. Review daily.")
bool volumeFilter = input.bool(false, "Filter by displacement · body/ATR", group=F, tooltip="Hypothesis: require a sufficiently large candle body relative to ATR. This is not an actual volume filter.")
bool dolFilter = input.bool(false, "Require session DOL", group=F, tooltip="Require an available prior-session level in the signal direction.")
bool vFilter = input.bool(false, "R: require V-window", group=F, tooltip="Require inversion shortly after the initial reversal sweep.")
bool smtFilter = input.bool(false, "Require confirmed SMT", group=F, tooltip="Require divergence between confirmed pivots of the chart symbol and its peer.")
bool allInverse = input.bool(true, "Require all eligible FVG inversions", group=F, tooltip="Model hypothesis: all eligible FVGs in the leg must invert.")
int vTTL = input.int(3, "V-window · bars", minval=1, maxval=50, group=F, tooltip="Adjustable timing proxy for a fast reversal: up to three bars from the R sweep or C contact by default. Time alone does not measure full V-shape geometry.")
int legLookback = input.int(40, "Maximum leg lookback", minval=3, maxval=300, group=F, tooltip="Maximum lookback bars when searching for setup FVGs.")
int signalPivotLeft = input.int(3, "Signal pivot · left bars", minval=1, maxval=50, group=F, tooltip="Left bars for the internal signal pivot.")
int signalPivotRight = input.int(3, "Signal pivot · right bars", minval=1, maxval=50, group=F, tooltip="Right bars required to confirm the internal pivot.")
int signalGapAge = input.int(20, "Maximum signal FVG age", minval=1, maxval=100, group=F, tooltip="Maximum FVG age in bars to participate in the setup.")
float displacementATR = input.float(0.8, "Minimum displacement · body/ATR", minval=0, step=0.1, group=F, tooltip="Experimental threshold for candle-body size relative to ATR.")
int confluenceTTL = input.int(20, "Recent HTF/SMT window · bars", minval=1, maxval=200, group=F, tooltip="Chart bars during which an HTF contact or SMT event counts as recent.")
bool killFilter = input.bool(false, "Restrict signals to kill zones", group=F, tooltip="When enabled, only allow signals inside enabled kill-zone windows.")
int signalLimit = input.int(150, "Maximum signal labels", minval=1, maxval=200, group=S, tooltip="Visual limit for recent labels; does not change calculated signals.")
bool allHistoryMarkers = input.bool(true, "Show signals across loaded history", group=S, tooltip="Draw fixed historical markers. TradingView limits how many bars are actually loaded.")
bool visibleSignalTooltips = input.bool(true, "Show confluences on hover", group=S, tooltip="Signals inside the visible chart use hoverable labels. Older signals remain fixed historical markers; scrolling recalculates the visible labels. At most 250 visible signals can have detailed labels at once.")
color bullColor = input.color(color.rgb(20, 195, 142), "Bullish color", group=S, tooltip="Color of bullish labels and some supporting markers.")
color bearColor = input.color(color.rgb(255, 70, 78), "Bearish color", group=S, tooltip="Color of bearish labels and some supporting markers.")
string signalSize = input.string("Small", "Signal label size", options=["Tiny", "Small", "Normal", "Large"], group=S, tooltip="Size of detailed labels attached to visible signals.")
color signalTextColor = input.color(color.rgb(50, 50, 50), "R/R+/C text color", group=S, tooltip="Text color for C, R and R+ labels.")
string reversalText = input.string("R", "Reversal label text", group=S, tooltip="Customize reversal text on visible labels.")
string continuationText = input.string("C", "Continuation label text", group=S, tooltip="Customize continuation text on visible labels.")
bool recentSignals = input.bool(false, "Recent signals only · display", group=S, tooltip="Reduce the number of recent labels without changing calculations.")
int recentSignalCount = input.int(2, "Recent signal count", minval=1, maxval=200, group=S, tooltip="Used when Recent signals only is enabled.")
string tooltipIcons = input.string("Green / red", "Hover icon colors", options=["Green / red", "Blue / orange", "Plain"], group=S, tooltip="TradingView controls the hover window's text colors and font size. These are preset Unicode icon colors; use the panel color inputs for exact custom colors.")
string rMarker = input.string("Directional", "R marker", options=["Directional", "Box", "Circle", "Diamond", "Text only"], group=S, active=appearanceMode == "Custom", tooltip="Choose a shape or plain text with no background. Minimal preset overrides this display setting.")
string rpMarker = input.string("Directional", "R+ marker", options=["Directional", "Box", "Circle", "Diamond", "Text only"], group=S, active=appearanceMode == "Custom", tooltip="Choose a shape or plain text with no background. Minimal preset overrides this display setting.")
string cMarker = input.string("Directional", "C marker", options=["Directional", "Box", "Circle", "Diamond", "Text only"], group=S, active=appearanceMode == "Custom", tooltip="Choose a shape or plain text with no background. Minimal preset overrides this display setting.")
bool sizeFilter = input.bool(true, "Enable minimum FVG size", group=G2, tooltip="Ignore chart zones smaller than the configured threshold.")
float minSize = input.float(0.5, "Minimum FVG size", minval=0, step=0.25, group=G2, tooltip="Chart FVG size threshold in the selected unit.")
string sizeUnit = input.string("Points", "Minimum-size unit", options=["Points", "Ticks", "ATR"], group=G2, tooltip="Points, symbol ticks or multiples of ATR.")
int gapLimit = input.int(60, "Visible chart FVG limit", minval=5, maxval=80, group=G2, tooltip="Limit visible boxes. Does not directly limit analytical zone state.")
string gapDisplay = input.string("Fixed compact", "Chart FVG/iFVG display mode", options=["Fixed compact", "Moving compact", "Follow price"], group=G2, tooltip="Affects chart-timeframe FVG/iFVG boxes only. Fixed compact keeps boxes near their origin; Moving compact shows a recent window. Does not change calculations or signals. The 15m, 1h and 4h FVGs have separate controls.")
int compactGapBars = input.int(12, "Compact width · chart bars", minval=2, maxval=200, group=G2, tooltip="Visual width of compact chart FVG/iFVG boxes. Does not shorten analytical zone validity.")
string chartGapScope = input.string("Signal-linked only", "Which chart gaps to show", options=["Signal-linked only", "All gaps"], group=G2, tooltip="Default: show only inverted chart FVGs that participated in a confirmed R/R+/C setup. All gaps displays every qualifying chart FVG/iFVG. HTF boxes and the signal engine are independent. Linked boxes appear only when a signal confirms; their left edge shows the earlier gap origin.")
bool chartGapText = input.bool(true, "Show chart gap text", group=G2, tooltip="Show FVG+/FVG-/iFVG captions inside chart boxes.")
string chartGapTextSize = input.string("Tiny", "Chart gap text size", options=["Tiny", "Small", "Normal"], group=G2, tooltip="Chart-timeframe boxes only. HTF layers retain their own text sizes.")
color chartBullGapColor = input.color(color.gray, "Bullish FVG color", group=G2, tooltip="Independent chart zone and caption color.")
color chartBearGapColor = input.color(color.gray, "Bearish FVG color", group=G2, tooltip="Independent chart zone and caption color.")
color chartBullInverseColor = input.color(color.rgb(20, 195, 142), "Bullish iFVG color", group=G2, tooltip="Independent chart zone and caption color.")
color chartBearInverseColor = input.color(color.rgb(255, 70, 78), "Bearish iFVG color", group=G2, tooltip="Independent chart zone and caption color.")
int chartGapOpacity = input.int(88, "Chart gap transparency · %", minval=0, maxval=100, group=G2, tooltip="0 opaque, 100 transparent. Does not affect HTF zones.")
int chartGapBorderWidth = input.int(1, "Chart gap border width", minval=0, maxval=4, group=G2, tooltip="Use zero for a borderless chart gap.")
int pivotLeft = input.int(20, "Liquidity swing · left bars", minval=1, maxval=100, group=G3, tooltip="Left pivot bars used for liquidity, SMT and LRL.")
int pivotRight = input.int(2, "Liquidity swing · right bars", minval=1, maxval=50, group=G3, tooltip="Right bars required to confirm a swing.")
int levelLimit = input.int(10, "Stored swing level limit", minval=2, maxval=30, group=G3, tooltip="Limit stored swing levels. Adjust carefully because this can affect sweep detection.")
float visualSwingATR = input.float(1.5, "Visual significance · range/ATR", minval=0.0, step=0.25, group=G3, tooltip="Visual filter only: swing range divided by ATR(200). The former default 5 hid many confirmed swings; 1.5 shows more context. Set 0 for all confirmed swings. Analytical levels and C/R/R+ rules are unchanged.")
int visualSwingLimit = input.int(8, "Maximum visible swing lines", minval=1, maxval=20, group=G3, tooltip="Each swing $$$ marker belongs to a line. When this limit removes an older level, its line and labels are removed together.")
string liquidityTagMode = input.string("$$$", "Swing liquidity label", options=["BSL / SSL", "$$$", "Off"], group=G3, tooltip="$$$ represents resting liquidity at a confirmed swing high/low. Its horizontal line starts at that pivot and ends when price sweeps it.")
bool showSweepTags = input.bool(true, "Show confirmed sweep markers", group=G3, tooltip="Add a second marker where price sweeps and reclaims a level. It stays linked to the same line and disappears if the level is hidden.")
string sweepTagText = input.string("SWP", "Sweep marker text", options=["SWP", "$$$"], group=G3, tooltip="SWP distinguishes a sweep event from $$$ resting liquidity. Select $$$ to use the same text for both events.")
color liquidityHighColor = input.color(color.rgb(255, 125, 125), "High / BSL color", group=G3, tooltip="Color of BSL levels and swing highs.")
color liquidityLowColor = input.color(color.rgb(82, 214, 164), "Low / SSL color", group=G3, tooltip="Color of SSL levels and swing lows.")
color sweptColor = input.color(color.rgb(190, 190, 190), "Swept liquidity color", group=G3, tooltip="Line color after a confirmed sweep.")
string liquidityMarker = input.string("Text only", "Swing liquidity label shape", options=["Directional", "Box", "Circle", "Diamond", "Text only"], group=G3, active=appearanceMode == "Custom", tooltip="Choose a shape or plain text with no background. Minimal preset overrides this display setting.")
string sweepMarker = input.string("Text only", "Sweep event label style", options=["Directional", "Box", "Circle", "Diamond", "Text only"], group=G3, active=appearanceMode == "Custom", tooltip="Choose a shape or plain text with no background. Minimal preset overrides this display setting.")
int liquidityWidth = input.int(1, "Swing liquidity line width", minval=1, maxval=5, group=G3, tooltip="Visual stroke width only; does not change detection.")
string liquidityTagSize = input.string("Inherit", "Swing liquidity · text size", options=["Inherit", "Tiny", "Small", "Normal"], group=G3, tooltip="Inherit uses the shared chart label size. This changes only this family.")
string liquidityLineStyle = input.string("Solid", "Swing liquidity · line style", options=["Solid", "Dashed", "Dotted"], group=G3, tooltip="Visual line style only; detection and alerts are unchanged.")
string sweepTagSize = input.string("Inherit", "Sweep event · text size", options=["Inherit", "Tiny", "Small", "Normal"], group=G3, tooltip="Inherit uses the shared chart label size. This changes only this family.")
int swingHistoryLimit = input.int(40, "Historical swing lines", minval=0, maxval=60, group=G3, tooltip="Retain older drawn swing lines separately from the analytical level limit. Set zero to hide them. They are visual context and do not become new R/C targets. A line stops when its source price is swept.")
float equalATR = input.float(0.15, "EQH/EQL tolerance · ATR", minval=0, step=0.01, group=G3E, tooltip="Allowed distance between two extremes to classify them as equal.")
int equalLimit = input.int(2, "Maximum equal-high/low levels", minval=1, maxval=20, group=G3E, tooltip="Limit retained EQH/EQL levels.")
bool showEqualTags = input.bool(true, "Show EQH/EQL labels", group=G3E, tooltip="Display labels on equal-high/low levels.")
color equalLevelColor = input.color(color.rgb(255, 162, 36), "EQH / EQL color", group=G3E, tooltip="Color of equal-high/low levels.")
int equalWidth = input.int(1, "EQH/EQL line width", minval=1, maxval=5, group=G3E, tooltip="Visual stroke width only; does not change detection.")
string equalMarker = input.string("Text only", "EQH/EQL · label shape", options=["Directional", "Box", "Circle", "Diamond", "Text only"], group=G3E, active=appearanceMode == "Custom", tooltip="Customize this family independently. Text only has no arrow or background; other families keep their own style. Display only.")
string equalTagSize = input.string("Inherit", "EQH/EQL · text size", options=["Inherit", "Tiny", "Small", "Normal"], group=G3E, tooltip="Inherit uses the shared chart label size. This changes only this family.")
string equalLineStyle = input.string("Dotted", "EQH/EQL · line style", options=["Solid", "Dashed", "Dotted"], group=G3E, tooltip="Visual line style only; detection and alerts are unchanged.")
string lrlGeometry = input.string("Balanced", "LRL geometry profile", options=["Balanced", "Custom / v26"], group=G3L, tooltip="Balanced uses 1.5 ATR(14) alignment and 8 ATR(200) cluster range. It accepts wider, approximately aligned structures while still requiring three intact failure swings. Custom / v26 uses the values below (0.5 / 4 by default). This is a provisional geometry convention, not the original formula. LRL availability can affect C model targets.")
int lrlPoints = input.int(3, "Minimum LRL touch points", minval=3, maxval=6, group=G3L, tooltip="Minimum aligned pivots required to form a line.")
int lrlVisualLimit = input.int(4, "Visible LRL line limit", minval=1, maxval=8, group=G3L, tooltip="Visual limit to reduce chart clutter.")
bool allowCross = input.bool(true, "Allow crossing between LRL pivots", group=G3L, tooltip="Allow a candle to cross the diagonal line between pivots. This does NOT allow sweeping the highs/lows that form the LRL; those touch points must remain intact.")
float lrlTolerance = input.float(0.5, "Custom alignment tolerance · ATR14", minval=0, step=0.1, group=G3L, active=lrlGeometry == "Custom / v26", tooltip="Maximum distance between pivots and the candidate line.")
float lrlClusterATR = input.float(4.0, "Custom cluster range · ATR200", minval=0.1, step=0.25, group=G3L, active=lrlGeometry == "Custom / v26", tooltip="Adjustable hypothesis: maximum distance between the highest and lowest pivots in the series, in ATR(200) multiples. Not a confirmed original-script threshold.")
int lrlMaxSpanBars = input.int(240, "LRL cluster maximum span · bars", minval=3, maxval=1000, group=G3L, tooltip="Adjustable hypothesis: touch points must form within this many chart bars.")
bool showLRLTags = input.bool(true, "Show LRL labels", group=G3L, tooltip="Repeat LRL at the pivots used by each line.")
color lrlColor = input.color(color.rgb(255, 175, 40), "LRL color", group=G3L, tooltip="Color of LRL lines and labels.")
string lrlMarker = input.string("Text only", "LRL label style", options=["Directional", "Box", "Circle", "Diamond", "Text only"], group=G3L, active=appearanceMode == "Custom", tooltip="Choose a shape or plain text with no background. Minimal preset overrides this display setting.")
int lrlWidth = input.int(1, "LRL line width", minval=1, maxval=5, group=G3L, tooltip="Visual stroke width only; does not change detection.")
string lrlTagSize = input.string("Inherit", "LRL · text size", options=["Inherit", "Tiny", "Small", "Normal"], group=G3L, tooltip="Inherit uses the shared chart label size. This changes only this family.")
string lrlLineStyle = input.string("Solid", "LRL · line style", options=["Solid", "Dashed", "Dotted"], group=G3L, tooltip="Visual line style only; detection and alerts are unchanged.")
int lrlStateLimit = input.int(4, "Stored LRL structures · calculation", minval=1, maxval=8, group=G3L, tooltip="Analytical retention cap, independent of visible lines. Default 4 preserves the v26 analytical cap. Changing this can change DOL and C targets; changing the visible line limit cannot.")
string tf1 = input.timeframe("15", "HTF 1 · 15m", group=G4, tooltip="First closed-bar FVG layer; 15 minutes by default.")
string tf2 = input.timeframe("60", "HTF 2 · 1h", group=G4, tooltip="Second closed-bar FVG layer; one hour by default.")
string tf3 = input.timeframe("240", "HTF 3 · 4h", group=G4, tooltip="Third confirmed FVG layer. Control its R+ participation in the R/R+ setup section.")
string mitigation = input.string("100%", "HTF FVG mitigation threshold", options=["On Touch", "50%", "100%"], group=G4, tooltip="Remove a zone after first touch, midpoint or full mitigation.")
string mitigationType = input.string("Wicks", "Mitigation source", options=["Wicks", "Close"], group=G4, tooltip="Use wicks or closes to determine zone mitigation.")
int htfLimit = input.int(6, "Visible active FVGs per timeframe", minval=1, maxval=30, group=G4, tooltip="Limit drawn active boxes only, not calculated FVGs. Increase to inspect older zones that are still active.")
bool htf1Visible = input.bool(true, "Show 15m boxes", group=G4, tooltip="Independent display control for the first HTF layer.")
