bool htf3Extend = input.bool(false, "Extend 4h boxes", group=G4, tooltip="Extend 4h boxes to the right until mitigation.")
color htf1Color = input.color(color.rgb(126, 170, 220), "15m FVG color", group=G4, tooltip="Customize boxes and text of the first HTF layer.")
color htf2Color = input.color(color.rgb(190, 153, 220), "1h FVG color", group=G4, tooltip="Customize boxes and text of the second HTF layer.")
