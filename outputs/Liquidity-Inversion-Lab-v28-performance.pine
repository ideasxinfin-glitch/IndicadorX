// Visual controls preserved from earlier versions; model rules changed in 0.20.
string resolvedSignalSize = signalSize == "Tiny" ? size.tiny : signalSize == "Small" ? size.small : signalSize == "Large" ? size.large : size.normal
string resolvedChartTagSize = chartTagSize == "Tiny" ? size.tiny : chartTagSize == "Normal" ? size.normal : size.small
float atr = ta.atr(14)
float atr200 = ta.atr(200)
float resolvedLrlTolerance = lrlGeometry == "Balanced" ? 1.5 : lrlTolerance
float resolvedLrlCluster = lrlGeometry == "Balanced" ? 8.0 : lrlClusterATR
f_tagY(float price, int direction, float tier) =>
    price + direction * math.max(nz(atr, 0.0) * chartTagGapATR * tier, syminfo.mintick * 12 * tier)
color resolvedTagBackground = color.new(chartTagBackground, chartTagTransparency)
float gapMinimum = not sizeFilter ? 0.0 : sizeUnit == "Ticks" ? minSize * syminfo.mintick : sizeUnit == "ATR" ? minSize * atr : minSize
int barMillis = int(timeframe.in_seconds() * 1000)


f_visualMode(string requested) =>
    appearanceMode == "Minimal" ? "Text only" : requested
f_labelStyle(string requested, int direction) =>
    string mode = f_visualMode(requested)
    mode == "Text only" ? label.style_none : mode == "Box" ? label.style_label_center : mode == "Circle" ? label.style_circle : mode == "Diamond" ? label.style_diamond : direction == 1 ? label.style_label_down : label.style_label_up
f_labelBackground(string requested, color background) =>
    f_visualMode(requested) == "Text only" ? color(na) : background
f_tagSize(string requested) =>
    requested == "Tiny" ? size.tiny : requested == "Small" ? size.small : requested == "Normal" ? size.normal : resolvedChartTagSize
f_lineStyle(string requested) =>
    requested == "Dashed" ? line.style_dashed : requested == "Dotted" ? line.style_dotted : line.style_solid
f_sessionMarker(string caption) =>
    caption == "AS" ? asiaMarker : caption == "LDN" ? londonMarker : nyMarker
f_sessionTagSize(string caption) =>
    f_tagSize(caption == "AS" ? asiaTagSize : caption == "LDN" ? londonTagSize : nyTagSize)
f_sessionLineStyle(string caption) =>
    f_lineStyle(caption == "AS" ? asiaLineStyle : caption == "LDN" ? londonLineStyle : nyLineStyle)
f_referenceMarker(string caption) =>
    str.contains(caption, "PD") or str.contains(caption, "PW") or str.contains(caption, "PM") ? priorMarker : str.contains(caption, "MO") ? monthMarker : str.contains(caption, "WO") and not str.contains(caption, "DO") ? weekMarker : dayMarker
f_referenceSize(string caption) =>
    f_tagSize(str.contains(caption, "PD") or str.contains(caption, "PW") or str.contains(caption, "PM") ? priorTagSize : str.contains(caption, "MO") ? monthTagSize : str.contains(caption, "WO") and not str.contains(caption, "DO") ? weekTagSize : dayTagSize)

f_sessionColor(string caption, int direction) =>
    caption == "AS" ? (direction == 1 ? asiaHighColor : asiaLowColor) : caption == "LDN" ? (direction == 1 ? londonHighColor : londonLowColor) : (direction == 1 ? nyHighColor : nyLowColor)
f_sessionWidth(string caption, int direction) =>
    caption == "AS" ? (direction == 1 ? asiaHighWidth : asiaLowWidth) : caption == "LDN" ? (direction == 1 ? londonHighWidth : londonLowWidth) : (direction == 1 ? nyHighWidth : nyLowWidth)

type Gap
    float top
    float bottom
    int direction
    int born
    int inversion = na
    box drawing = na
    int originTime = na

type Level
    float price
    int direction
    int bornTime
    bool touched = false
    line drawing = na
    label tag = na
    label sweepTag = na
    string source = ""
    int touchTime = na

type Setup
    int started = na
    int legStart = na
    bool active = false
    bool delivered = false
    float zoneTop = na
    float zoneBottom = na
    string zoneTf = "-"
    float zoneMinutes = na
    int zoneBorn = na
    float sweepPrice = na
    string sweepSource = "-"

type ContinuationZone
    float top
    float bottom
    int direction
    int confirmedTime
    int born
    string source
    bool used = false

type SessionState
    float hi = na
    float lo = na
    bool wasIn = false
    int hiTime = na
    int loTime = na
    line openDrawing = na

type LRLStructure
    int direction
    float breachPrice
    line drawing
    array<int> contactTimes
    array<float> contactPrices

