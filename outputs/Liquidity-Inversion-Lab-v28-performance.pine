f_archiveSwing(Level lv) =>
    if swingHistoryLimit > 0 and not na(lv.drawing)
        // Copy visual ownership without aliasing analytical touched state.
        archivedSwings.push(Level.new(lv.price, lv.direction, lv.bornTime, lv.touched, lv.drawing, lv.tag, lv.sweepTag, lv.source, lv.touchTime))
        if archivedSwings.size() > swingHistoryLimit
            Level retired = archivedSwings.shift()
            line.delete(retired.drawing)
            label.delete(retired.tag)
            label.delete(retired.sweepTag)
    else
        line.delete(lv.drawing)
        label.delete(lv.tag)
        label.delete(lv.sweepTag)
    lv.drawing := na
    lv.tag := na
    lv.sweepTag := na
    // Keep this helper void in every branch; Pine otherwise infers a label return.
    label.delete(lv.sweepTag)

f_addLevel(array<Level> levels, float price, int direction, int bornTime, bool visible, string caption, int maxCount) =>
    line drawing = na
    label tag = na
    if visible
        bool equalLevel = caption == "EQ"
        bool sessionLevel = caption == "AS" or caption == "LDN" or caption == "NY"
        color levelColor = equalLevel ? equalLevelColor : sessionLevel ? f_sessionColor(caption, direction) : direction == 1 ? liquidityHighColor : liquidityLowColor
        string levelStyle = sessionLevel ? f_sessionLineStyle(caption) : equalLevel ? f_lineStyle(equalLineStyle) : f_lineStyle(liquidityLineStyle)
        drawing := line.new(bornTime, price, time, price, xloc=xloc.bar_time, extend=extend.right, color=color.new(levelColor, equalLevel ? 45 : 20), style=levelStyle, width=sessionLevel ? f_sessionWidth(caption, direction) : equalLevel ? equalWidth : liquidityWidth)
        bool allowTag = showLevelTags and (equalLevel ? showEqualTags : sessionLevel ? showSessionTags : liquidityTagMode != "Off")
        if allowTag
            string tagText = equalLevel ? direction == 1 ? "EQH" : "EQL" : sessionLevel ? caption + (direction == 1 ? " H" : " L") : liquidityTagMode == "$$$" ? "$$$" : caption
            string explanation = equalLevel ? "Relatively equal high/low" : sessionLevel ? "Completed-session extreme" : "Resting liquidity at a confirmed swing; the line starts at this pivot and stops when a wick sweeps it"
            tag := label.new(bornTime, f_tagY(price, direction, 1.0), tagText, xloc=xloc.bar_time, yloc=yloc.price, style=f_labelStyle(sessionLevel ? f_sessionMarker(caption) : equalLevel ? equalMarker : liquidityMarker, direction), color=f_labelBackground(sessionLevel ? f_sessionMarker(caption) : equalLevel ? equalMarker : liquidityMarker, resolvedTagBackground), textcolor=levelColor, size=sessionLevel ? f_sessionTagSize(caption) : f_tagSize(equalLevel ? equalTagSize : liquidityTagSize), tooltip=explanation + (sessionLevel ? "; known when the session ends" : "; known after pivot confirmation"))
    levels.push(Level.new(price, direction, bornTime, false, drawing, tag, na, caption, na))
    bool capSwing = caption == "BSL" or caption == "SSL"
    bool capSession = caption == "AS" or caption == "LDN" or caption == "NY"
    if capSwing or capSession
        // Retain the newest drawings in one backwards pass; analytical levels stay intact.
        int retainedDrawings = 0
        int drawingIndex = levels.size() - 1
        int drawingBudget = capSwing ? visualSwingLimit : visibleSessionLimit
        while drawingIndex >= 0
            Level lv = levels.get(drawingIndex)
            if not na(lv.drawing)
                retainedDrawings += 1
                if retainedDrawings > drawingBudget
                    if capSwing
                        f_archiveSwing(lv)
                    else
                        line.delete(lv.drawing)
                        label.delete(lv.tag)
                        label.delete(lv.sweepTag)
                        lv.drawing := na
                        lv.tag := na
                        lv.sweepTag := na
                        label.delete(lv.sweepTag)
            drawingIndex -= 1
    if levels.size() > maxCount
        Level old = levels.shift()
        if capSwing
            f_archiveSwing(old)
        else
            line.delete(old.drawing)
            label.delete(old.tag)
            label.delete(old.sweepTag)

f_updateArchivedSwings() =>
    for lv in archivedSwings
        if not lv.touched and (lv.direction == 1 ? high > lv.price : low < lv.price)
            lv.touched := true
            line.set_x2(lv.drawing, time)
            line.set_extend(lv.drawing, extend.none)
            line.set_style(lv.drawing, line.style_dashed)
            line.set_color(lv.drawing, color.new(sweptColor, 35))
            if not na(lv.tag)
                label.set_textcolor(lv.tag, sweptColor)
                label.set_tooltip(lv.tag, "Historical swing already swept. Visual context only; retired from the analytical queue.")

f_extraLine(int t1, float p1, int t2, float p2, color c, string style, int side) =>
    line l = line.new(t1, p1, t2, p2, xloc=xloc.bar_time, color=c, style=style, width=smtWidth)
    extraLines.push(l)
    label tag = na
    if smtLineLabels
        tag := label.new(t2, f_tagY(p2, side, 2.0), "SMT · " + peer, xloc=xloc.bar_time, yloc=yloc.price, style=f_labelStyle(smtMarker, side), color=f_labelBackground(smtMarker, resolvedTagBackground), textcolor=c, size=f_tagSize(smtTagSize), tooltip="Confirmed divergence vs " + peer + ". Line endpoints are independently confirmed pivots; detection is delayed by pivot confirmation.")
    smtLineTags.push(tag)
    if extraLines.size() > 30
        line.delete(extraLines.shift())
        label.delete(smtLineTags.shift())

f_referenceTag(float price, string caption, color tagColor) =>
    label.new(bar_index + openTagOffset, price, caption, yloc=yloc.price, style=f_labelStyle(f_referenceMarker(caption), 1), color=f_labelBackground(f_referenceMarker(caption), resolvedTagBackground), textcolor=tagColor, size=f_referenceSize(caption), tooltip=caption + " · Reference level")

f_session(SessionState state, bool inside, string caption, bool visible, bool openVisible, array<Level> destination) =>
    if inside and not state.wasIn
        if not na(state.openDrawing)
            line.set_extend(state.openDrawing, extend.none)
            line.set_x2(state.openDrawing, time)
        state.openDrawing := na
        if openVisible
            color openColor = caption == "AS" ? asiaKeyColor : caption == "LDN" ? londonKeyColor : nyKeyColor
            string openStyle = f_sessionLineStyle(caption)
            state.openDrawing := line.new(time, open, time_close, open, xloc=xloc.bar_time, extend=extend.right, color=openColor, style=openStyle, width=sessionOpenWidth)
            label openTag = na
            if showLevelTags and showOpenTags
                openTag := label.new(time, f_tagY(open, 1, 1.1), caption + " O", xloc=xloc.bar_time, yloc=yloc.price, style=f_labelStyle(f_sessionMarker(caption), 1), color=f_labelBackground(f_sessionMarker(caption), resolvedTagBackground), textcolor=openColor, size=f_sessionTagSize(caption), tooltip="Open of " + caption + "; known from the first session bar")
            sessionOpenLines.push(state.openDrawing)
            sessionOpenTags.push(openTag)
            if sessionOpenLines.size() > 30
                line.delete(sessionOpenLines.shift())
                label.delete(sessionOpenTags.shift())
    if inside
        if not state.wasIn or na(state.hi) or high > state.hi
            state.hi := high
            state.hiTime := time
        if not state.wasIn or na(state.lo) or low < state.lo
            state.lo := low
            state.loTime := time
    if not inside and state.wasIn
        f_addLevel(destination, state.hi, 1, state.hiTime, visible, caption, 18)
        f_addLevel(destination, state.lo, -1, state.loTime, visible, caption, 18)
    state.wasIn := inside

f_sweeps(array<Level> levels, bool hideTouched, bool markVisibleSwing) =>
    bool sellside = false
    bool buyside = false
    bool sellsideMarked = false
    bool buysideMarked = false
    for lv in levels
        if not lv.touched
            bool crossed = lv.direction == 1 ? high > lv.price : low < lv.price
            if crossed
                sellside := sellside or (lv.direction == -1 and close > lv.price)
                buyside := buyside or (lv.direction == 1 and close < lv.price)
                bool visibleReclaim = markVisibleSwing and not na(lv.drawing) and time >= chart.left_visible_bar_time and time <= chart.right_visible_bar_time
                if visibleReclaim and showSweepTags and lv.direction == -1 and close > lv.price and not sellsideMarked
                    lv.sweepTag := label.new(time, f_tagY(lv.price, -1, 1.8), sweepTagText, xloc=xloc.bar_time, yloc=yloc.price, style=f_labelStyle(sweepMarker, -1), color=f_labelBackground(sweepMarker, resolvedTagBackground), textcolor=sweptColor, size=f_tagSize(sweepTagSize), tooltip="SSL sweep and reclaim. The line connects this event to its source swing.")
                    sellsideMarked := true
                if visibleReclaim and showSweepTags and lv.direction == 1 and close < lv.price and not buysideMarked
                    lv.sweepTag := label.new(time, f_tagY(lv.price, 1, 1.8), sweepTagText, xloc=xloc.bar_time, yloc=yloc.price, style=f_labelStyle(sweepMarker, 1), color=f_labelBackground(sweepMarker, resolvedTagBackground), textcolor=sweptColor, size=f_tagSize(sweepTagSize), tooltip="BSL sweep and reclaim. The line connects this event to its source swing.")
                    buysideMarked := true
                lv.touched := true
                lv.touchTime := time
                if not na(lv.drawing)
                    line.set_x2(lv.drawing, time)
                    line.set_extend(lv.drawing, extend.none)
                    line.set_style(lv.drawing, line.style_dashed)
                    line.set_color(lv.drawing, color.new(sweptColor, 35))
                    if hideTouched
                        line.delete(lv.drawing)
                        lv.drawing := na
                        label.delete(lv.sweepTag)
                        lv.sweepTag := na
                if not na(lv.tag)
                    if hideTouched
                        label.delete(lv.tag)
                        lv.tag := na
                    else
                        label.set_textcolor(lv.tag, sweptColor)
                        label.set_tooltip(lv.tag, "Level " + lv.source + " already swept; the dashed line ends at the sweep candle.")
    [sellside, buyside]

f_addGap(array<Gap> collection, float top, float bottom, int direction, int born, int leftTime, bool visible, string caption, int maxCount, color zoneColor, string zoneTextSize, bool chartZone = false) =>
    box drawing = na
    if visible
        string renderedSize = zoneTextSize == "Normal" ? size.normal : zoneTextSize == "Small" ? size.small : size.tiny
        drawing := box.new(leftTime, top, time_close, bottom, xloc=xloc.bar_time, border_color=color.new(zoneColor, 55), bgcolor=color.new(zoneColor, chartZone ? chartGapOpacity : 85), border_width=chartZone ? chartGapBorderWidth : 1, text=caption, text_color=zoneColor, text_size=renderedSize, text_halign=text.align_right)
    collection.push(Gap.new(top, bottom, direction, born, na, drawing, leftTime))
    // A display budget must not silently remove an active analytical zone.
    int retainedDrawings = 0
    int drawingIndex = collection.size() - 1
    while drawingIndex >= 0
        Gap g = collection.get(drawingIndex)
        if not na(g.drawing)
            retainedDrawings += 1
            if retainedDrawings > maxCount
                box.delete(g.drawing)
                g.drawing := na
        drawingIndex -= 1
    // Fail explicitly rather than silently discard active HTF state.
    if collection.size() > 1000
        runtime.error("More than 1000 retained gaps. Narrow the loaded history or choose a higher timeframe; state was not silently truncated.")

f_higher(array<Gap> collection, bool extendRight, bool retainMitigated, array<box> mitigatedDrawings, int mitigatedLimit, bool nativeChartTf) =>
    bool bullTouch = false
    bool bearTouch = false
    bool tagged = false
    bool midpoint = false
    int i = collection.size() - 1
    while i >= 0
        Gap g = collection.get(i)
        // During historical replay, intermediate positions are never displayed.
        // Keep the final confirmed-bar geometry; mitigated boxes are frozen below.
        if not na(g.drawing) and (barstate.islast or barstate.islastconfirmedhistory)
            box.set_right(g.drawing, time_close)
            box.set_extend(g.drawing, extendRight ? extend.right : extend.none)
        // A same-timeframe FVG becomes known only at this bar's close.
        bool contact = (not nativeChartTf or g.born < bar_index) and low <= g.top and high >= g.bottom
        float mid = math.avg(g.top, g.bottom)
        bullTouch := bullTouch or (contact and g.direction == 1)
        bearTouch := bearTouch or (contact and g.direction == -1)
        tagged := tagged or contact
        midpoint := midpoint or (low <= mid and high >= mid)
        float lowerSource = mitigationType == "Close" ? close : low
        float upperSource = mitigationType == "Close" ? close : high
        float threshold = mitigation == "50%" ? mid : g.direction == 1 ? g.bottom : g.top
        bool invalid = nativeChartTf and g.born == bar_index ? false : (mitigation == "On Touch" ? contact : (g.direction == 1 ? lowerSource <= threshold : upperSource >= threshold))
        if invalid
            if retainMitigated and not na(g.drawing)
                box.set_extend(g.drawing, extend.none)
                box.set_right(g.drawing, time_close)
                box.set_bgcolor(g.drawing, color.new(color.gray, 93))
                box.set_border_color(g.drawing, color.new(color.gray, 75))
                box.set_text(g.drawing, "4h mitigated")
                mitigatedDrawings.push(g.drawing)
                if mitigatedDrawings.size() > mitigatedLimit
                    box.delete(mitigatedDrawings.shift())
            else
                box.delete(g.drawing)
            collection.remove(i)
        i -= 1
    [bullTouch, bearTouch, tagged, midpoint]

f_ready(Setup s, int direction) =>
    int count = 0
    int completed = 0
    bool inProcess = false
    bool newlyInverted = false
    if s.active
        for g in gaps
            if g.direction == -direction and g.born >= s.legStart and bar_index - g.born <= signalGapAge and (na(g.inversion) or g.inversion >= s.started)
                count += 1
                completed += not na(g.inversion) ? 1 : 0
                newlyInverted := newlyInverted or g.inversion == bar_index
                inProcess := inProcess or (na(g.inversion) and close > g.bottom and close < g.top)
    // Expiring an old gap must not create a signal without a fresh inversion.
    bool ready = newlyInverted and count > 0 and (allInverse ? completed == count : completed > 0)
    [ready, inProcess, count, completed]

f_drawLinkedGaps(Setup selected, int direction) =>
    if showIFVG and chartGapScope == "Signal-linked only"
        for g in gaps
            bool participates = g.direction == -direction and g.born >= selected.legStart and bar_index - g.born <= signalGapAge and not na(g.inversion) and g.inversion >= selected.started
            if participates and na(g.drawing)
                color zoneColor = direction == 1 ? chartBullInverseColor : chartBearInverseColor
                int rightTime = gapDisplay == "Follow price" ? time_close : math.min(time_close, g.originTime + compactGapBars * barMillis)
                int leftTime = gapDisplay == "Moving compact" ? math.max(g.originTime, time_close - compactGapBars * barMillis) : g.originTime
                if gapDisplay == "Moving compact"
                    rightTime := time_close
                g.drawing := box.new(leftTime, g.top, rightTime, g.bottom, xloc=xloc.bar_time, border_color=color.new(zoneColor, 55), border_width=chartGapBorderWidth, bgcolor=color.new(zoneColor, chartGapOpacity), text=chartGapText ? "iFVG" : "", text_color=zoneColor, text_size=f_tagSize(chartGapTextSize), text_halign=text.align_right)
                linkedGapBoxes.push(g)
                if linkedGapBoxes.size() > gapLimit
                    Gap oldOwner = linkedGapBoxes.shift()
                    box.delete(oldOwner.drawing)
                    oldOwner.drawing := na

// Wick sweep and source are captured BEFORE the visual sweep routine consumes levels.
f_wickSweep(array<Level> levels, int side) =>
    bool found = false
    float price = na
    string source = "-"
    int newest = na
    for lv in levels
        bool crossed = side == 1 ? high > lv.price : low < lv.price
        if lv.direction == side and not lv.touched and crossed and (na(newest) or lv.bornTime > newest)
            found := true
            price := lv.price
            source := lv.source + (side == 1 ? " H" : " L")
            newest := lv.bornTime
    [found, price, source]

f_stageReversal(array<Level> levels, Setup bull, Setup bear, int bullLeg, int bearLeg) =>
    [buySweep, buyPrice, buySource] = f_wickSweep(levels, -1)
    [sellSweep, sellPrice, sellSource] = f_wickSweep(levels, 1)
    if buySweep
        bull.started := bar_index
        bull.legStart := math.max(nz(bullLeg, bar_index - legLookback), bar_index - legLookback)
        bull.active := true
        bull.delivered := false
        bull.zoneTf := "-"
        bull.zoneTop := na
        bull.zoneBottom := na
        bull.zoneBorn := na
        bull.zoneMinutes := na
        bull.sweepPrice := buyPrice
        bull.sweepSource := buySource
    if sellSweep
        bear.started := bar_index
        bear.legStart := math.max(nz(bearLeg, bar_index - legLookback), bar_index - legLookback)
        bear.active := true
        bear.delivered := false
        bear.zoneTf := "-"
        bear.zoneTop := na
        bear.zoneBottom := na
        bear.zoneBorn := na
        bear.zoneMinutes := na
        bear.sweepPrice := sellPrice
        bear.sweepSource := sellSource

f_linkReversalZone(Setup s, array<Gap> zones, int direction, simple string source) =>
    if s.active and s.started == bar_index
        float extreme = direction == 1 ? low : high
        for g in zones
            bool closeValid = direction == 1 ? close >= g.bottom : close <= g.top
            bool knownBeforeSweep = g.born < bar_index or timeframe.in_seconds(source) > timeframe.in_seconds()
            if knownBeforeSweep and g.direction == direction and extreme >= g.bottom and extreme <= g.top and closeValid
                s.delivered := true
                s.zoneTop := g.top
                s.zoneBottom := g.bottom
                s.zoneTf := source
                s.zoneMinutes := timeframe.in_seconds(source) / 60.0
                s.zoneBorn := g.born

f_target(array<Level> levels, int direction) =>
    float price = na
    string source = "-"
    for lv in levels
        bool eligible = not lv.touched and lv.direction == direction and (direction == 1 ? lv.price > close : lv.price < close)
        if eligible and (na(price) or (direction == 1 ? lv.price < price : lv.price > price))
            price := lv.price
            source := lv.source + (direction == 1 ? " H" : " L")
    [price, source]

f_addContinuationZone(float top, float bottom, int direction, int confirmedTime, string source) =>
    continuationZones.push(ContinuationZone.new(top, bottom, direction, confirmedTime, bar_index, source))
    if continuationZones.size() > 200
        continuationZones.shift()

f_retestContinuation(Setup s, int direction, int trend, int legStart, bool hasTarget) =>
    if not s.active and trend == direction and hasTarget
        int chosen = na
        int chosenFrame = 0
        int chosenTime = na
        if continuationZones.size() > 0
            for zoneIndex = 0 to continuationZones.size() - 1
                ContinuationZone z = continuationZones.get(zoneIndex)
                int sourceMinutes = z.source == "15" ? 15 : 5
                int sourceMillis = sourceMinutes * 60000
                bool enabled = z.source == "15" ? continuation15m : continuation5m
                bool fresh = time >= z.confirmedTime and time - z.confirmedTime <= continuationAge * sourceMillis
                bool approached = direction == 1 ? close[1] > z.top : close[1] < z.bottom
                bool overlap = low <= z.top and high >= z.bottom
                bool closeValid = direction == 1 ? close >= z.bottom : close <= z.top
                if enabled and z.direction == direction and not z.used and fresh and approached and overlap and closeValid and (sourceMinutes > chosenFrame or (sourceMinutes == chosenFrame and (na(chosenTime) or z.confirmedTime > chosenTime)))
                    chosen := zoneIndex
                    chosenFrame := sourceMinutes
                    chosenTime := z.confirmedTime
        if not na(chosen)
            ContinuationZone z = continuationZones.get(chosen)
            s.active := true
            s.started := bar_index
            s.legStart := math.max(math.max(nz(legStart, bar_index - legLookback), bar_index - legLookback), z.born)
            s.delivered := true
            s.zoneTop := z.top
            s.zoneBottom := z.bottom
            s.zoneTf := z.source
            s.zoneMinutes := chosenFrame
            s.zoneBorn := z.born
            s.sweepSource := "FVG retracement · " + z.source
            z.used := true

f_applyLRLDisplay() =>
    int retained = 0
    int index = lrlStructures.size() - 1
    while index >= 0
        LRLStructure item = lrlStructures.get(index)
        retained += 1
        if showLRL and retained <= lrlVisualLimit
            if na(item.drawing)
                int last = item.contactTimes.size() - 1
                item.drawing := line.new(item.contactTimes.get(0), item.contactPrices.get(0), item.contactTimes.get(last), item.contactPrices.get(last), xloc=xloc.bar_time, extend=extend.right, color=color.new(lrlColor, 25), style=f_lineStyle(lrlLineStyle), width=lrlWidth)
        else
            line.delete(item.drawing)
            item.drawing := na
        index -= 1

f_refreshLRLTags() =>
    f_applyLRLDisplay()
    for tag in lrlTags
        label.delete(tag)
    lrlTags.clear()
    if showLRL and showLRLTags
        array<int> seenTimes = array.new<int>()
        array<float> seenPrices = array.new<float>()
        for structureItem in lrlStructures
            if not na(structureItem.drawing)
                for pointIndex = 0 to structureItem.contactTimes.size() - 1
                    int pointTime = structureItem.contactTimes.get(pointIndex)
                    float pointPrice = structureItem.contactPrices.get(pointIndex)
                    bool alreadyTagged = false
                    if seenTimes.size() > 0
                        for seenIndex = 0 to seenTimes.size() - 1
                            alreadyTagged := alreadyTagged or (seenTimes.get(seenIndex) == pointTime and math.abs(seenPrices.get(seenIndex) - pointPrice) <= syminfo.mintick)
                    if not alreadyTagged
                        seenTimes.push(pointTime)
                        seenPrices.push(pointPrice)
                        lrlTags.push(label.new(pointTime, f_tagY(pointPrice, structureItem.direction, 2.2), "LRL", xloc=xloc.bar_time, yloc=yloc.price, style=f_labelStyle(lrlMarker, structureItem.direction), color=f_labelBackground(lrlMarker, resolvedTagBackground), textcolor=lrlColor, size=f_tagSize(lrlTagSize), tooltip="LRL: confirmed pivot, unswept at formation. Remove the line if any touch-point liquidity is swept."))

f_lrl(array<float> prices, array<int> bars, array<int> times, array<bool> swept, int direction) =>
    bool formed = false
    if prices.size() >= lrlPoints and not na(atr200)
        int first = prices.size() - lrlPoints
        int last = prices.size() - 1
        int x0 = bars.get(first)
        int x1 = bars.get(last)
        float y0 = prices.get(first)
        float y1 = prices.get(last)
        float slope = x1 > x0 ? (y1 - y0) / (x1 - x0) : 0.0
        float equalTolerance = equalATR * atr200
        float minimumPrice = y0
        float maximumPrice = y0
        bool valid = x1 > x0 and x1 - x0 <= lrlMaxSpanBars and not na(atr)
        for i = first to last
            valid := valid and not swept.get(i)
            minimumPrice := math.min(minimumPrice, prices.get(i))
            maximumPrice := math.max(maximumPrice, prices.get(i))
            if i > first
                bool failureSwing = direction == 1 ? prices.get(i) <= prices.get(i - 1) + equalTolerance : prices.get(i) >= prices.get(i - 1) - equalTolerance
                float expected = y0 + slope * (bars.get(i) - x0)
                valid := valid and failureSwing and math.abs(prices.get(i) - expected) <= atr * resolvedLrlTolerance
        valid := valid and maximumPrice - minimumPrice <= resolvedLrlCluster * atr200
        int age = bar_index - x0
        if not allowCross and valid
            if age > 4000
                valid := false
            else
                for offset = pivotRight to age
                    float expected = y0 + slope * (bar_index - offset - x0)
                    bool pierces = direction == 1 ? high[offset] > expected + syminfo.mintick : low[offset] < expected - syminfo.mintick
                    valid := valid and not pierces
                    if not valid
                        break
        if valid
            // Replace overlapping structures rather than stack near-identical lines.
            int existingIndex = lrlStructures.size() - 1
            while existingIndex >= 0
                LRLStructure prior = lrlStructures.get(existingIndex)
                if prior.direction == direction and prior.contactTimes.get(prior.contactTimes.size() - 1) >= times.get(first)
                    line.delete(prior.drawing)
                    lrlStructures.remove(existingIndex)
                existingIndex -= 1
            array<int> selectedTimes = array.new<int>()
            array<float> selectedPrices = array.new<float>()
            for i = first to last
                selectedTimes.push(times.get(i))
                selectedPrices.push(prices.get(i))
            line drawing = na
            if showLRL
                drawing := line.new(times.get(first), y0, times.get(last), y1, xloc=xloc.bar_time, extend=extend.right, color=color.new(lrlColor, 25), style=f_lineStyle(lrlLineStyle), width=lrlWidth)
            // A high-side structure is swept at its lowest high; the low side at its highest low.
            float breachPrice = direction == 1 ? minimumPrice : maximumPrice
            lrlStructures.push(LRLStructure.new(direction, breachPrice, drawing, selectedTimes, selectedPrices))
            if lrlStructures.size() > lrlStateLimit
                LRLStructure oldest = lrlStructures.shift()
                line.delete(oldest.drawing)
            f_refreshLRLTags()
            formed := true
    formed

// Closed HTF bars only: every requested expression is offset, with lookahead_on.
// HTF gap creation is delayed until the first confirmed chart bar of the next HTF period.
[h1, l1, h1old, l1old, t1, left1] = request.security(syminfo.tickerid, tf1, [high[1], low[1], high[3], low[3], time[1], time[3]], lookahead=barmerge.lookahead_on)
[h2, l2, h2old, l2old, t2, left2] = request.security(syminfo.tickerid, tf2, [high[1], low[1], high[3], low[3], time[1], time[3]], lookahead=barmerge.lookahead_on)
[h3, l3, h3old, l3old, t3, left3] = request.security(syminfo.tickerid, tf3, [high[1], low[1], high[3], low[3], time[1], time[3]], lookahead=barmerge.lookahead_on)
[peerPH, peerPL, peerPivotTime] = request.security(peer, timeframe.period, [ta.pivothigh(high, pivotLeft, pivotRight), ta.pivotlow(low, pivotLeft, pivotRight), time[pivotRight]], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
// Current period OPEN is fixed at period start; prior values use [1]. One request per timeframe.
[priorDH, priorDL, dayOpen] = request.security(syminfo.tickerid, "D", [high[1], low[1], open], lookahead=barmerge.lookahead_on)
[priorWH, priorWL, weekOpen, priorWeekClose] = request.security(syminfo.tickerid, "W", [high[1], low[1], open, close[1]], lookahead=barmerge.lookahead_on)
[priorMH, priorML, monthOpen] = request.security(syminfo.tickerid, "M", [high[1], low[1], open], lookahead=barmerge.lookahead_on)
[hourTime, hourHigh, hourLow, hourOpen] = request.security(syminfo.tickerid, "60", [time[1], high[1], low[1], open[1]], lookahead=barmerge.lookahead_on)
[c5High, c5Low, c5OldHigh, c5OldLow, c5Confirmed] = request.security(syminfo.tickerid, "5", [high[1], low[1], high[3], low[3], time_close[1]], lookahead=barmerge.lookahead_on)
[c15High, c15Low, c15OldHigh, c15OldLow, c15Confirmed] = request.security(syminfo.tickerid, "15", [high[1], low[1], high[3], low[3], time_close[1]], lookahead=barmerge.lookahead_on)

// Only compare a layer on chart intervals at or below that layer. A 4h chart
// cannot reconstruct complete 15m or 1h FVG histories from request.security().
int chartSeconds = timeframe.in_seconds()
bool tf1Usable = timeframe.in_seconds(tf1) >= chartSeconds
bool tf2Usable = timeframe.in_seconds(tf2) >= chartSeconds
bool tf3Usable = timeframe.in_seconds(tf3) >= chartSeconds
bool hourRangeUsable = chartSeconds <= 3600
bool reversalLtfUsable = chartSeconds >= 30 and chartSeconds <= 300
bool continuationLtfUsable = chartSeconds >= 30 and chartSeconds <= 180

float ph = ta.pivothigh(high, pivotLeft, pivotRight)
float pl = ta.pivotlow(low, pivotLeft, pivotRight)
float highSwingRange = ph - ta.lowest(low, pivotLeft + pivotRight + 1)
float lowSwingRange = ta.highest(high, pivotLeft + pivotRight + 1) - pl
float signalPH = ta.pivothigh(high, signalPivotLeft, signalPivotRight)
float signalPL = ta.pivotlow(low, signalPivotLeft, signalPivotRight)
var int lastSignalHighBar = na
var int lastSignalLowBar = na
bool inAsia = not na(time(timeframe.period, asiaSession, zone))
bool inLondon = not na(time(timeframe.period, londonSession, zone))
bool inNY = not na(time(timeframe.period, nySession, zone))
bool inPremarket = not na(time(timeframe.period, "0800-0930", zone))
bool inNYKillzone = not na(time(timeframe.period, useNyExtended ? nyExtendedKZ : nyKZ, zone))
bool inLondonKillzone = includeLondonKZ and not na(time(timeframe.period, londonKZ, zone))
bool inAsiaKillzone = includeAsiaKZ and not na(time(timeframe.period, asiaKZ, zone))
bool inKillzone = inNYKillzone or inLondonKillzone or inAsiaKillzone
int minuteNY = minute(time, zone)
int hourNY = hour(time, zone)
// Six windows: 09:50-10:10 through 14:50-15:10, end exclusive.
bool macro = (hourNY >= 9 and hourNY <= 14 and minuteNY >= 50) or (hourNY >= 10 and hourNY <= 15 and minuteNY < 10)
var float lastHigh = na
var float lastLow = na
var float previousChartHigh = na
var float previousChartLow = na
var int previousChartHighTime = na
var int previousChartLowTime = na
var float peerHighPrevious = na
var float peerHighCurrent = na
var float peerLowPrevious = na
var float peerLowCurrent = na
var int peerHighPreviousTime = na
var int peerHighCurrentTime = na
var int peerLowPreviousTime = na
var int peerLowCurrentTime = na
var int lastMarkedSmtHighTime = na
var int lastMarkedSmtLowTime = na
var int lastHighBar = na
var int lastLowBar = na
var int lastHighTime = na
var int lastLowTime = na
var int structure = 0
var int lastBullHTF = na
var int lastBearHTF = na
// Provenance is diagnostic only. TF1/TF2 default to 15m/1h and are editable.
var int lastBullTF1 = na
var int lastBearTF1 = na
var int lastBullTF2 = na
var int lastBearTF2 = na
var int lastBullTF3 = na
var int lastBearTF3 = na
var int lastBullSMT = na
var int lastBearSMT = na
var float cr8hi = na
var float cr8lo = na
var float cr9hi = na
var float cr9lo = na
var int crDay = na
var array<bool> checklist = array.new<bool>(8, false)
var int checklistDirection = 0
var string checklistKind = "No confirmed signal"
var string checklistHtfSource = "-"
var string checklistDolSource = "-"
var string checklistModelTarget = "-"
var int checklistTime = na
var int checklistCount = 0
var array<bool> inspectedChecklist = array.new<bool>(8, false)
var bool inspectedFound = false
var int inspectedDirection = 0
var string inspectedKind = "No signal on selected bar"
var string inspectedHtfSource = "-"
var string inspectedDolSource = "-"
var string inspectedModelTarget = "-"
var int inspectedTime = na
var int inspectedCount = 0

bool sweepLong = false
bool sweepShort = false
bool smtBull = false
bool smtBear = false
bool lrlBull = false
bool lrlBear = false
bool newBull1 = false
bool newBear1 = false
bool newBull2 = false
bool newBear2 = false
bool newBull3 = false
bool newBear3 = false
bool touch1 = false
bool touch2 = false
bool mid1 = false
bool mid2 = false
bool touch3 = false
bool mid3 = false
bool processLong = false
bool processShort = false
bool inverseBull = false
bool inverseBear = false
int longGapCount = 0
int shortGapCount = 0
int signalCode = 0
bool signalDetailDrawn = false
bool displacement = not na(atr) and math.abs(close - open) >= atr * displacementATR
bool dolLong = false
bool dolShort = false
string dolLongSource = "-"
string dolShortSource = "-"
float dolLongPrice = na
float dolShortPrice = na
float modelTargetLong = na
float modelTargetShort = na
string modelTargetLongSource = "-"
string modelTargetShortSource = "-"
float signalZoneTop = na
float signalZoneBottom = na
float signalZoneTf = na
float signalSweepPrice = na
bool londonSweptAsiaHigh = false
bool londonSweptAsiaLow = false
bool nySweptAsiaHigh = false
bool nySweptAsiaLow = false
bool nySweptLondonHigh = false
bool nySweptLondonLow = false
int diagnosticLongStart = na
int diagnosticShortStart = na
bool range8HighTap = false
bool range8LowTap = false
bool range9HighTap = false
bool range9LowTap = false
var bool range8HighTouched = false
var bool range8LowTouched = false
var bool range9HighTouched = false
var bool range9LowTouched = false
var line current8HighLine = na
var line current8LowLine = na
var line current9HighLine = na
var line current9LowLine = na
var line current8OpenLine = na
var line current9OpenLine = na
int trendBeforeBar = structure
int manualTrend = biasInput == "Bullish" ? 1 : biasInput == "Bearish" ? -1 : 0
int continuationTrendBeforeBar = continuationTrendMode == "Manual bias" ? manualTrend : trendBeforeBar

if barstate.isconfirmed
    // Sweep state is updated before adding any newly confirmed pivot. A single
    // wick beyond any contact invalidates the active LRL on this closed bar.
    if hiSwept.size() > 0
        for i = 0 to hiSwept.size() - 1
            if high > hiPoints.get(i)
                hiSwept.set(i, true)
    if loSwept.size() > 0
        for i = 0 to loSwept.size() - 1
            if low < loPoints.get(i)
                loSwept.set(i, true)
    bool lrlRemoved = false
    int structureIndex = lrlStructures.size() - 1
    while structureIndex >= 0
        LRLStructure active = lrlStructures.get(structureIndex)
        bool breached = active.direction == 1 ? high > active.breachPrice : low < active.breachPrice
        if breached
            line.delete(active.drawing)
            lrlStructures.remove(structureIndex)
            lrlRemoved := true
        structureIndex -= 1
    if lrlRemoved
        f_refreshLRLTags()
    f_updateArchivedSwings()
    f_session(asia, inAsia, "AS", sessionLines and showAsiaLevels, showAsiaOpen, priorSessions)
    f_session(london, inLondon, "LDN", sessionLines and showLondonLevels, showLondonOpen, priorSessions)
    f_session(newYork, inNY, "NY", sessionLines and showNYLevels, showNYOpen, priorSessions)
    f_session(premarket, inPremarket, "PM", false, false, keySignalLevels)
    if timeframe.change("D")
        f_addLevel(keySignalLevels, priorDH, 1, time, false, "PD", 18)
        f_addLevel(keySignalLevels, priorDL, -1, time, false, "PD", 18)
    // Peer pivots are calculated in the peer's own series, not sampled at NQ pivots.
    if not na(peerPH) and (na(peerHighCurrentTime) or peerPivotTime != peerHighCurrentTime)
        peerHighPrevious := peerHighCurrent
        peerHighPreviousTime := peerHighCurrentTime
        peerHighCurrent := peerPH
        peerHighCurrentTime := peerPivotTime
    if not na(peerPL) and (na(peerLowCurrentTime) or peerPivotTime != peerLowCurrentTime)
        peerLowPrevious := peerLowCurrent
        peerLowPreviousTime := peerLowCurrentTime
        peerLowCurrent := peerPL
        peerLowCurrentTime := peerPivotTime
    // Levels are known only after pivotRight bars. No signal is backdated.
    if not na(ph)
        if not na(lastHigh) and math.abs(ph - lastHigh) <= equalATR * atr200[pivotRight]
            f_addLevel(equalLevels, math.max(ph, lastHigh), 1, lastHighTime, showEqual, "EQ", equalLimit)
        previousChartHigh := lastHigh
        previousChartHighTime := lastHighTime
        lastHigh := ph
        lastHighBar := bar_index - pivotRight
        lastHighTime := time[pivotRight]
        bool significantHigh = not na(atr200[pivotRight]) and highSwingRange >= visualSwingATR * atr200[pivotRight]
        f_addLevel(swingLevels, ph, 1, time[pivotRight], showLiquidity and significantHigh, "BSL", levelLimit)
        hiPoints.push(ph)
        hiBars.push(lastHighBar)
        hiTimes.push(lastHighTime)
        hiSwept.push(false)
        if hiPoints.size() > 6
            hiPoints.shift()
            hiBars.shift()
            hiTimes.shift()
            hiSwept.shift()
        lrlBull := f_lrl(hiPoints, hiBars, hiTimes, hiSwept, 1)
    if not na(pl)
        if not na(lastLow) and math.abs(pl - lastLow) <= equalATR * atr200[pivotRight]
            f_addLevel(equalLevels, math.min(pl, lastLow), -1, lastLowTime, showEqual, "EQ", equalLimit)
        previousChartLow := lastLow
        previousChartLowTime := lastLowTime
        lastLow := pl
        lastLowBar := bar_index - pivotRight
        lastLowTime := time[pivotRight]
        bool significantLow = not na(atr200[pivotRight]) and lowSwingRange >= visualSwingATR * atr200[pivotRight]
        f_addLevel(swingLevels, pl, -1, time[pivotRight], showLiquidity and significantLow, "SSL", levelLimit)
        loPoints.push(pl)
        loBars.push(lastLowBar)
        loTimes.push(lastLowTime)
        loSwept.push(false)
        if loPoints.size() > 6
            loPoints.shift()
            loBars.shift()
            loTimes.shift()
            loSwept.shift()
        lrlBear := f_lrl(loPoints, loBars, loTimes, loSwept, -1)

    int smtTolerance = smtSyncBars * barMillis
    bool alignedHighs = not na(previousChartHighTime) and not na(lastHighTime) and not na(peerHighPreviousTime) and not na(peerHighCurrentTime) and math.abs(previousChartHighTime - peerHighPreviousTime) <= smtTolerance and math.abs(lastHighTime - peerHighCurrentTime) <= smtTolerance
    bool alignedLows = not na(previousChartLowTime) and not na(lastLowTime) and not na(peerLowPreviousTime) and not na(peerLowCurrentTime) and math.abs(previousChartLowTime - peerLowPreviousTime) <= smtTolerance and math.abs(lastLowTime - peerLowCurrentTime) <= smtTolerance
    smtBear := alignedHighs and not na(previousChartHigh) and not na(lastHigh) and not na(peerHighPrevious) and not na(peerHighCurrent) and lastHigh > previousChartHigh + atr * smtBreakATR and peerHighCurrent < peerHighPrevious and (na(lastMarkedSmtHighTime) or lastMarkedSmtHighTime != lastHighTime)
    smtBull := alignedLows and not na(previousChartLow) and not na(lastLow) and not na(peerLowPrevious) and not na(peerLowCurrent) and lastLow < previousChartLow - atr * smtBreakATR and peerLowCurrent > peerLowPrevious and (na(lastMarkedSmtLowTime) or lastMarkedSmtLowTime != lastLowTime)
    if smtBear
        lastMarkedSmtHighTime := lastHighTime
        lastBearSMT := bar_index
        if showSMT
            f_extraLine(previousChartHighTime, previousChartHigh, lastHighTime, lastHigh, smtBearColor, f_lineStyle(smtLineStyle), 1)
    if smtBull
        lastMarkedSmtLowTime := lastLowTime
        lastBullSMT := bar_index
        if showSMT
            f_extraLine(previousChartLowTime, previousChartLow, lastLowTime, lastLow, smtBullColor, f_lineStyle(smtLineStyle), -1)

    // Explicit key levels outrank a generic swing if both are swept on this bar.
    if not na(signalPH)
        lastSignalHighBar := bar_index - signalPivotRight
        f_addLevel(signalLevels, signalPH, 1, time[signalPivotRight], false, "Internal", 60)
    if not na(signalPL)
        lastSignalLowBar := bar_index - signalPivotRight
        f_addLevel(signalLevels, signalPL, -1, time[signalPivotRight], false, "Internal", 60)
    if reversalLtfUsable
        if shortPivotR
            f_stageReversal(signalLevels, longSetup, shortSetup, lastSignalHighBar, lastSignalLowBar)
        f_stageReversal(swingLevels, longSetup, shortSetup, lastSignalHighBar, lastSignalLowBar)
        f_stageReversal(equalLevels, longSetup, shortSetup, lastSignalHighBar, lastSignalLowBar)
        f_stageReversal(priorSessions, longSetup, shortSetup, lastSignalHighBar, lastSignalLowBar)
        f_stageReversal(keySignalLevels, longSetup, shortSetup, lastSignalHighBar, lastSignalLowBar)
    [sl1, ss1] = f_sweeps(swingLevels, false, true)
    [sl2, ss2] = f_sweeps(equalLevels, true, false)
    [sl3, ss3] = f_sweeps(priorSessions, false, false)
    [sl4, ss4] = f_sweeps(keySignalLevels, false, false)
    sweepLong := sl1 or sl2 or sl3 or sl4
    sweepShort := ss1 or ss2 or ss3 or ss4
    for lv in priorSessions
        bool recentSession = time >= lv.bornTime and time - lv.bornTime <= sessionDolHours * 3600000
        if recentSession and not lv.touched and lv.direction == 1 and lv.price > close and (na(dolLongPrice) or lv.price < dolLongPrice)
            dolLongPrice := lv.price
            dolLongSource := lv.source + " H"
        if recentSession and not lv.touched and lv.direction == -1 and lv.price < close and (na(dolShortPrice) or lv.price > dolShortPrice)
            dolShortPrice := lv.price
            dolShortSource := lv.source + " L"
        if recentSession and lv.touchTime == time
            bool londonAsia = inLondon and lv.source == "AS"
            bool nyAsia = inNY and lv.source == "AS"
            bool nyLondon = inNY and lv.source == "LDN"
            londonSweptAsiaHigh := londonSweptAsiaHigh or (londonAsia and lv.direction == 1)
            londonSweptAsiaLow := londonSweptAsiaLow or (londonAsia and lv.direction == -1)
            nySweptAsiaHigh := nySweptAsiaHigh or (nyAsia and lv.direction == 1)
            nySweptAsiaLow := nySweptAsiaLow or (nyAsia and lv.direction == -1)
            nySweptLondonHigh := nySweptLondonHigh or (nyLondon and lv.direction == 1)
            nySweptLondonLow := nySweptLondonLow or (nyLondon and lv.direction == -1)
            if showSessionSweepEvents and not na(lv.drawing) and (londonAsia or nyAsia or nyLondon) and time >= chart.left_visible_bar_time and time <= chart.right_visible_bar_time
                string actor = inLondon ? "LDN" : "NY"
                string side = lv.direction == 1 ? "H" : "L"
                lv.sweepTag := label.new(time, f_tagY(lv.price, lv.direction, 1.8), actor + ">" + lv.source + " " + side, xloc=xloc.bar_time, yloc=yloc.price, style=f_labelStyle(sweepMarker, lv.direction), color=f_labelBackground(sweepMarker, resolvedTagBackground), textcolor=sweptColor, size=f_tagSize(sweepTagSize), tooltip=actor + " swept " + lv.source + " " + side + " with a wick; this target is no longer available as DOL")
    dolLong := not na(dolLongPrice)
    dolShort := not na(dolShortPrice)
    [targetBuy1, targetBuySource1] = f_target(swingLevels, 1)
    [targetBuy2, targetBuySource2] = f_target(equalLevels, 1)
    [targetBuy3, targetBuySource3] = f_target(priorSessions, 1)
    [targetBuy4, targetBuySource4] = f_target(keySignalLevels, 1)
    [targetSell1, targetSellSource1] = f_target(swingLevels, -1)
    [targetSell2, targetSellSource2] = f_target(equalLevels, -1)
    [targetSell3, targetSellSource3] = f_target(priorSessions, -1)
    [targetSell4, targetSellSource4] = f_target(keySignalLevels, -1)
    array<float> buyTargets = array.from(targetBuy1, targetBuy2, targetBuy3, targetBuy4)
    array<string> buySources = array.from(targetBuySource1, targetBuySource2, targetBuySource3, targetBuySource4)
    array<float> sellTargets = array.from(targetSell1, targetSell2, targetSell3, targetSell4)
    array<string> sellSources = array.from(targetSellSource1, targetSellSource2, targetSellSource3, targetSellSource4)
    for targetIndex = 0 to 3
        float buyTarget = buyTargets.get(targetIndex)
        float sellTarget = sellTargets.get(targetIndex)
        if not na(buyTarget) and (na(modelTargetLong) or buyTarget < modelTargetLong)
            modelTargetLong := buyTarget
            modelTargetLongSource := buySources.get(targetIndex)
        if not na(sellTarget) and (na(modelTargetShort) or sellTarget > modelTargetShort)
            modelTargetShort := sellTarget
            modelTargetShortSource := sellSources.get(targetIndex)
    for lrlItem in lrlStructures
        if lrlItem.direction == 1 and lrlItem.breachPrice > close and (na(modelTargetLong) or lrlItem.breachPrice < modelTargetLong)
            modelTargetLong := lrlItem.breachPrice
            modelTargetLongSource := "LRL H"
        if lrlItem.direction == -1 and lrlItem.breachPrice < close and (na(modelTargetShort) or lrlItem.breachPrice > modelTargetShort)
            modelTargetShort := lrlItem.breachPrice
            modelTargetShortSource := "LRL L"
    if not na(lastHigh) and close > lastHigh
        structure := 1
    if not na(lastLow) and close < lastLow
        structure := -1

    if tf1Usable and (timeframe.in_seconds(tf1) == chartSeconds or t1 != t1[1])
        bool native1 = timeframe.in_seconds(tf1) == chartSeconds
        newBull1 := native1 ? low > high[2] : l1 > h1old
        newBear1 := native1 ? high < low[2] : h1 < l1old
        if newBull1 or newBear1
            f_addGap(higher1, newBull1 ? (native1 ? low : l1) : (native1 ? low[2] : l1old), newBull1 ? (native1 ? high[2] : h1old) : (native1 ? high : h1), newBull1 ? 1 : -1, bar_index, native1 ? time[2] : left1, htfOn and htf1Visible, htf1Text ? tf1 + " FVG" : "", htfLimit, htf1Color, htf1TextSize)
    if tf2Usable and (timeframe.in_seconds(tf2) == chartSeconds or t2 != t2[1])
        bool native2 = timeframe.in_seconds(tf2) == chartSeconds
        newBull2 := native2 ? low > high[2] : l2 > h2old
        newBear2 := native2 ? high < low[2] : h2 < l2old
        if newBull2 or newBear2
            f_addGap(higher2, newBull2 ? (native2 ? low : l2) : (native2 ? low[2] : l2old), newBull2 ? (native2 ? high[2] : h2old) : (native2 ? high : h2), newBull2 ? 1 : -1, bar_index, native2 ? time[2] : left2, htfOn and htf2Visible, htf2Text ? tf2 + " FVG" : "", htfLimit, htf2Color, htf2TextSize)
    if tf3Usable and (timeframe.in_seconds(tf3) == chartSeconds or t3 != t3[1])
        bool native3 = timeframe.in_seconds(tf3) == chartSeconds
        newBull3 := native3 ? low > high[2] : l3 > h3old
        newBear3 := native3 ? high < low[2] : h3 < l3old
        if newBull3 or newBear3
            f_addGap(higher3, newBull3 ? (native3 ? low : l3) : (native3 ? low[2] : l3old), newBull3 ? (native3 ? high[2] : h3old) : (native3 ? high : h3), newBull3 ? 1 : -1, bar_index, native3 ? time[2] : left3, htfOn and htf3Visible, htf3Text ? tf3 + " FVG" : "", htfLimit, htf3Color, htf3TextSize)
    // Capture origin before mitigation can remove the touched box.
    f_linkReversalZone(longSetup, higher1, 1, tf1)
    f_linkReversalZone(shortSetup, higher1, -1, tf1)
    f_linkReversalZone(longSetup, higher2, 1, tf2)
    f_linkReversalZone(shortSetup, higher2, -1, tf2)
    if reversal4h
        f_linkReversalZone(longSetup, higher3, 1, tf3)
        f_linkReversalZone(shortSetup, higher3, -1, tf3)
    [bt1, st1, tg1, md1] = f_higher(higher1, htf1Extend, false, mitigated4hDrawings, htf3MitigatedLimit, timeframe.in_seconds(tf1) == chartSeconds)
    [bt2, st2, tg2, md2] = f_higher(higher2, htf2Extend, false, mitigated4hDrawings, htf3MitigatedLimit, timeframe.in_seconds(tf2) == chartSeconds)
    [bt3, st3, tg3, md3] = f_higher(higher3, htf3Extend, htfOn and htf3Visible and htf3ShowMitigated, mitigated4hDrawings, htf3MitigatedLimit, timeframe.in_seconds(tf3) == chartSeconds)
    touch1 := tg1
    touch2 := tg2
    mid1 := md1
    mid2 := md2
    touch3 := tg3
    mid3 := md3
    if bt1
        lastBullTF1 := bar_index
    if st1
        lastBearTF1 := bar_index
    if bt2
        lastBullTF2 := bar_index
    if st2
        lastBearTF2 := bar_index
    if bt3
        lastBullTF3 := bar_index
    if st3
        lastBearTF3 := bar_index
    if bt1 or bt2 or (htf3Confluence and bt3)
        lastBullHTF := bar_index
    if st1 or st2 or (htf3Confluence and st3)
        lastBearHTF := bar_index

    // Chart-gap state has a deterministic time horizon independent of drawing count.
    // "All gaps" keeps 300 bars so its boxes keep updating; "Signal-linked only" keeps
    // exactly the signalGapAge window that readiness and linked drawing can use.
    // Linked boxes live in linkedGapBoxes and are not deleted by this expiry.
    int retainBars = chartGapScope == "All gaps" ? math.max(300, signalGapAge) : signalGapAge
    int gapIndex = gaps.size() - 1
    while gapIndex >= 0
        Gap oldGap = gaps.get(gapIndex)
        if bar_index - oldGap.born > retainBars
            // Linked drawings have a separate history pool after analytical expiry.
            if chartGapScope == "All gaps"
                box.delete(oldGap.drawing)
            gaps.remove(gapIndex)
        gapIndex -= 1
    if low > high[2] and low - high[2] >= gapMinimum
        f_addGap(gaps, low, high[2], 1, bar_index, time[2], showIFVG and chartGapScope == "All gaps", chartGapText ? "FVG+" : "", gapLimit, chartBullGapColor, chartGapTextSize, true)
    if high < low[2] and low[2] - high >= gapMinimum
        f_addGap(gaps, low[2], high, -1, bar_index, time[2], showIFVG and chartGapScope == "All gaps", chartGapText ? "FVG-" : "", gapLimit, chartBearGapColor, chartGapTextSize, true)
    for g in gaps
        if na(g.inversion)
            if not na(g.drawing)
                if gapDisplay != "Fixed compact"
                    box.set_right(g.drawing, time_close)
                if gapDisplay == "Moving compact"
                    box.set_left(g.drawing, math.max(box.get_left(g.drawing), time_close - compactGapBars * barMillis))
                if gapDisplay == "Fixed compact"
                    box.set_right(g.drawing, math.min(time_close, box.get_left(g.drawing) + compactGapBars * barMillis))
            bool inversed = g.direction == 1 ? close < g.bottom : close > g.top
            if inversed
                g.inversion := bar_index
                inverseBull := inverseBull or g.direction == -1
                inverseBear := inverseBear or g.direction == 1
                if not na(g.drawing)
                    color inverseColor = g.direction == -1 ? chartBullInverseColor : chartBearInverseColor
                    box.set_bgcolor(g.drawing, color.new(inverseColor, chartGapOpacity))
                    box.set_border_color(g.drawing, color.new(inverseColor, 55))
                    box.set_text_color(g.drawing, inverseColor)
                    box.set_text(g.drawing, chartGapText ? "iFVG" : "")

    // Short pivots are consumed even if their optional eligibility for R is disabled.
    [coreLong, coreShort] = f_sweeps(signalLevels, false, false)
    if continuationLtfUsable
        if c5Confirmed != c5Confirmed[1]
            if c5Low > c5OldHigh
                f_addContinuationZone(c5Low, c5OldHigh, 1, c5Confirmed, "5")
            if c5High < c5OldLow
                f_addContinuationZone(c5OldLow, c5High, -1, c5Confirmed, "5")
        if c15Confirmed != c15Confirmed[1]
            if c15Low > c15OldHigh
                f_addContinuationZone(c15Low, c15OldHigh, 1, c15Confirmed, "15")
            if c15High < c15OldLow
                f_addContinuationZone(c15OldLow, c15High, -1, c15Confirmed, "15")
        int continuationIndex = continuationZones.size() - 1
        while continuationIndex >= 0
            ContinuationZone z = continuationZones.get(continuationIndex)
            int sourceMillis = z.source == "15" ? 900000 : 300000
            bool invalid = z.direction == 1 ? close < z.bottom : close > z.top
            if invalid or time - z.confirmedTime > continuationAge * sourceMillis
                continuationZones.remove(continuationIndex)
            continuationIndex -= 1
    if longSetup.delivered and close < longSetup.zoneBottom
        longSetup.delivered := false
    if shortSetup.delivered and close > shortSetup.zoneTop
        shortSetup.delivered := false
    if longSetup.active and bar_index - longSetup.started > setupTTL
        longSetup.active := false
    if shortSetup.active and bar_index - shortSetup.started > setupTTL
        shortSetup.active := false
    int continuationTrendNow = continuationTrendMode == "Manual bias" ? manualTrend : structure
    if longContinuation.active and (bar_index - longContinuation.started > continuationTTL or close < longContinuation.zoneBottom or continuationTrendNow != 1 or na(modelTargetLong))
        longContinuation.active := false
    if shortContinuation.active and (bar_index - shortContinuation.started > continuationTTL or close > shortContinuation.zoneTop or continuationTrendNow != -1 or na(modelTargetShort))
        shortContinuation.active := false
    if continuationLtfUsable and continuationsOn
        f_retestContinuation(longContinuation, 1, continuationTrendBeforeBar, lastSignalHighBar, not na(modelTargetLong) and continuationTrendNow == 1)
        f_retestContinuation(shortContinuation, -1, continuationTrendBeforeBar, lastSignalLowBar, not na(modelTargetShort) and continuationTrendNow == -1)
    [readyLong, processingLong, countLong, completedLong] = f_ready(longSetup, 1)
    [readyShort, processingShort, countShort, completedShort] = f_ready(shortSetup, -1)
    [readyCLong, processingCLong, countCLong, completedCLong] = f_ready(longContinuation, 1)
    [readyCShort, processingCShort, countCShort, completedCShort] = f_ready(shortContinuation, -1)
    longGapCount := countLong
    shortGapCount := countShort
    processLong := processingLong or processingCLong
    processShort := processingShort or processingCShort
    diagnosticLongStart := longSetup.active ? longSetup.started : na
    diagnosticShortStart := shortSetup.active ? shortSetup.started : na
    bool htfLong = longSetup.active and longSetup.delivered
    bool htfShort = shortSetup.active and shortSetup.delivered
    bool smtLong = not na(lastBullSMT) and bar_index - lastBullSMT <= confluenceTTL
    bool smtShort = not na(lastBearSMT) and bar_index - lastBearSMT <= confluenceTTL
    bool vLong = longSetup.active and bar_index - longSetup.started <= vTTL
    bool vShort = shortSetup.active and bar_index - shortSetup.started <= vTTL
    bool common = (not volumeFilter or displacement) and (not killFilter or inKillzone)
    bool filterLong = common and biasInput != "Bearish" and (not dolFilter or dolLong) and (not smtFilter or smtLong)
    bool filterShort = common and biasInput != "Bullish" and (not dolFilter or dolShort) and (not smtFilter or smtShort)
    bool rLong = reversalLtfUsable and reversalsOn and readyLong and filterLong and (not vFilter or vLong) and (not onlyA or htfLong)
    bool rShort = reversalLtfUsable and reversalsOn and readyShort and filterShort and (not vFilter or vShort) and (not onlyA or htfShort)
    bool cLong = continuationLtfUsable and continuationsOn and readyCLong and continuationTrendNow == 1 and not na(modelTargetLong) and filterLong
    bool cShort = continuationLtfUsable and continuationsOn and readyCShort and continuationTrendNow == -1 and not na(modelTargetShort) and filterShort
    bool overlapLong = rLong and cLong
    bool overlapShort = rShort and cShort
    rLong := rLong and (not overlapLong or modelPriority == "R first")
    rShort := rShort and (not overlapShort or modelPriority == "R first")
    cLong := cLong and (not overlapLong or modelPriority == "C first")
    cShort := cShort and (not overlapShort or modelPriority == "C first")
    // If both directions satisfy conditions on the same bar, suppress ambiguity.
    bool candidateLong = rLong or cLong
    bool candidateShort = rShort or cShort
    if candidateLong != candidateShort
        int dir = candidateLong ? 1 : -1
        bool reversal = candidateLong ? rLong : rShort
        Setup selectedSetup = reversal ? (dir == 1 ? longSetup : shortSetup) : (dir == 1 ? longContinuation : shortContinuation)
        f_drawLinkedGaps(selectedSetup, dir)
        bool htf = selectedSetup.delivered
        signalCode := dir * (reversal ? (htf ? 3 : 2) : 1)
        checklistDirection := dir
        checklistKind := reversal ? (htf ? "R+" : "R") : "C"
        checklistTime := time
        checklistHtfSource := htf ? selectedSetup.zoneTf : "-"
        signalZoneTop := htf ? selectedSetup.zoneTop : na
        signalZoneBottom := htf ? selectedSetup.zoneBottom : na
        signalZoneTf := htf ? selectedSetup.zoneMinutes : na
        signalSweepPrice := reversal ? selectedSetup.sweepPrice : na
        float selectedTarget = dir == 1 ? modelTargetLong : modelTargetShort
        checklistModelTarget := dir == 1 ? modelTargetLongSource : modelTargetShortSource
        checklistModelTarget += not na(selectedTarget) ? " · " + str.tostring(selectedTarget, format.mintick) : ""
        checklistDolSource := dir == 1 ? dolLongSource : dolShortSource
        checklistDolSource += dir == 1 and not na(dolLongPrice) ? " · " + str.tostring(dolLongPrice, format.mintick) : dir == -1 and not na(dolShortPrice) ? " · " + str.tostring(dolShortPrice, format.mintick) : ""
        checklist.set(0, macro)
        // A reversal's sweep starts the setup; it usually precedes the signal bar.
        checklist.set(1, reversal ? (dir == 1 ? longSetup.active : shortSetup.active) : (dir == 1 ? sweepLong : sweepShort))
        checklist.set(2, htf)
        checklist.set(3, displacement)
        checklist.set(4, dir == 1 ? dolLong : dolShort)
        bool ltfDol = dir == 1 ? not na(lastHigh) and lastHigh > close : not na(lastLow) and lastLow < close
        checklist.set(5, ltfDol)
        checklist.set(6, bar_index - selectedSetup.started <= vTTL)
        checklist.set(7, dir == 1 ? smtLong : smtShort)
        checklistCount := 0
        for i = 0 to 7
            checklistCount += checklist.get(i) ? 1 : 0
        string signalTip = checklistKind + (dir == 1 ? "  ↑ Bullish" : "  ↓ Bearish") + "   ·   " + str.tostring(checklistCount) + "/8 observed confluences"
        signalTip += "\n" + str.format_time(time_close, "dd/MM/yyyy HH:mm", zone) + " NY"
        signalTip += "\n──────────────"
        string metIcon = tooltipIcons == "Plain" ? "↑" : tooltipIcons == "Blue / orange" ? "🔵↑" : "🟢↑"
        string unmetIcon = tooltipIcons == "Plain" ? "×" : tooltipIcons == "Blue / orange" ? "🟠×" : "❌"
        array<string> detailNames = array.from("Macro", "Setup sweep", "Linked HTF delivery", "Displacement body/ATR", "Session DOL", "LTF DOL", "V-window", "Confirmed-pivot SMT")
        for i = 0 to 7
            signalTip += "\n" + (checklist.get(i) ? metIcon : unmetIcon) + "  " + detailNames.get(i)
        signalTip += "\n──────────────"
        signalTip += "\nHTF source: " + checklistHtfSource
        signalTip += "\nAvailable session DOL: " + checklistDolSource
        signalTip += "\nOrigin: " + selectedSetup.sweepSource
        if reversal
            signalTip += " · " + str.tostring(selectedSetup.sweepPrice, format.mintick)
        if htf
            signalTip += "\nDelivery zone: " + str.tostring(selectedSetup.zoneBottom, format.mintick) + "–" + str.tostring(selectedSetup.zoneTop, format.mintick)
        signalTip += "\nModel DOL: " + checklistModelTarget
        if time <= inspectTime and inspectTime < time_close
            inspectedFound := true
            inspectedDirection := dir
            inspectedKind := checklistKind
            inspectedHtfSource := checklistHtfSource
            inspectedDolSource := checklistDolSource
            inspectedModelTarget := checklistModelTarget
            inspectedTime := time
            inspectedCount := checklistCount
            for i = 0 to 7
                inspectedChecklist.set(i, checklist.get(i))
            if signalsOn and inspectCallout and inspectMode == "Selected bar"
                label.new(bar_index, dir == 1 ? low - atr : high + atr, checklistKind + " " + str.tostring(checklistCount) + "/8", yloc=yloc.price, style=f_labelStyle(reversal ? (htf ? rpMarker : rMarker) : cMarker, -dir), color=f_labelBackground(reversal ? (htf ? rpMarker : rMarker) : cMarker, dir == 1 ? bullColor : bearColor), textcolor=f_visualMode(reversal ? (htf ? rpMarker : rMarker) : cMarker) == "Text only" ? (dir == 1 ? bullColor : bearColor) : signalTextColor, size=size.small, tooltip=signalTip)
        bool inVisibleWindow = time >= chart.left_visible_bar_time and time <= chart.right_visible_bar_time
        bool drawHoverLabel = signalsOn and (not allHistoryMarkers or (visibleSignalTooltips and inVisibleWindow and signalLabels.size() < 250 and label.all.size() < 420))
        if drawHoverLabel
            string visibleKind = reversal ? reversalText + (htf ? "+" : "") : continuationText
            label lab = label.new(bar_index, dir == 1 ? low : high, visibleKind, yloc=dir == 1 ? yloc.belowbar : yloc.abovebar, style=f_labelStyle(reversal ? (htf ? rpMarker : rMarker) : cMarker, -dir), color=f_labelBackground(reversal ? (htf ? rpMarker : rMarker) : cMarker, dir == 1 ? bullColor : bearColor), textcolor=f_visualMode(reversal ? (htf ? rpMarker : rMarker) : cMarker) == "Text only" ? (dir == 1 ? bullColor : bearColor) : signalTextColor, size=resolvedSignalSize, tooltip=signalTip)
            signalLabels.push(lab)
            signalDetailDrawn := allHistoryMarkers
            if not allHistoryMarkers and signalLabels.size() > (recentSignals ? math.min(signalLimit, recentSignalCount) : signalLimit)
                label.delete(signalLabels.shift())
    // Consume confirmed setup even when an optional filter rejects it; don't enter late.
    if readyLong
        longSetup.active := false
    if readyShort
        shortSetup.active := false
    if readyCLong
        longContinuation.active := false
    if readyCShort
        shortContinuation.active := false

    int dayKey = year(time, zone) * 10000 + month(time, zone) * 100 + dayofmonth(time, zone)
    if dayKey != crDay
        for crLine in array.from(current8HighLine, current8LowLine, current9HighLine, current9LowLine, current8OpenLine, current9OpenLine)
            if not na(crLine)
                line.set_extend(crLine, extend.none)
                line.set_x2(crLine, time)
        current8HighLine := na
        current8LowLine := na
        current9HighLine := na
        current9LowLine := na
        current8OpenLine := na
        current9OpenLine := na
        cr8hi := na
        cr8lo := na
        cr9hi := na
        cr9lo := na
        range8HighTouched := false
        range8LowTouched := false
        range9HighTouched := false
        range9LowTouched := false
    crDay := dayKey
    if hourRangeUsable and hourTime != hourTime[1]
        if hour(hourTime, zone) == 8
            cr8hi := hourHigh
            cr8lo := hourLow
            if showCR and showCR8 and not na(hourHigh) and not na(hourLow)
                current8HighLine := line.new(hourTime, hourHigh, time_close, hourHigh, xloc=xloc.bar_time, extend=extend.right, color=color.new(cr8Color, 35), width=cr8Width)
                current8LowLine := line.new(hourTime, hourLow, time_close, hourLow, xloc=xloc.bar_time, extend=extend.right, color=color.new(cr8Color, 35), width=cr8Width)
                crLines.push(current8HighLine)
                crLines.push(current8LowLine)
                if showCRTags and showLevelTags
                    crTags.push(label.new(hourTime, f_tagY(hourHigh, 1, 1.0), "8H", xloc=xloc.bar_time, yloc=yloc.price, style=f_labelStyle(cr8Marker, 1), color=f_labelBackground(cr8Marker, resolvedTagBackground), textcolor=cr8Color, size=f_tagSize(cr8TagSize), tooltip="8AM NY range; known after the candle closes at 09:00"))
                    crTags.push(label.new(hourTime, f_tagY(hourLow, -1, 1.0), "8L", xloc=xloc.bar_time, yloc=yloc.price, style=f_labelStyle(cr8Marker, -1), color=f_labelBackground(cr8Marker, resolvedTagBackground), textcolor=cr8Color, size=f_tagSize(cr8TagSize), tooltip="8AM NY range; known after the candle closes at 09:00"))
                if showCR8Open and not na(hourOpen)
                    current8OpenLine := line.new(hourTime, hourOpen, time_close, hourOpen, xloc=xloc.bar_time, extend=extend.right, color=color.new(cr8Color, 45), style=line.style_dotted, width=cr8Width)
                    crLines.push(current8OpenLine)
                    if showCRTags and showLevelTags
                        crTags.push(label.new(hourTime, f_tagY(hourOpen, 1, 1.25), "8O", xloc=xloc.bar_time, yloc=yloc.price, style=f_labelStyle(cr8Marker, 1), color=f_labelBackground(cr8Marker, resolvedTagBackground), textcolor=cr8Color, size=f_tagSize(cr8TagSize), tooltip="8AM NY candle open"))
        if hour(hourTime, zone) == 9
            cr9hi := hourHigh
            cr9lo := hourLow
            if showCR and showCR9 and not na(hourHigh) and not na(hourLow)
                current9HighLine := line.new(hourTime, hourHigh, time_close, hourHigh, xloc=xloc.bar_time, extend=extend.right, color=color.new(cr9Color, 35), width=cr9Width)
                current9LowLine := line.new(hourTime, hourLow, time_close, hourLow, xloc=xloc.bar_time, extend=extend.right, color=color.new(cr9Color, 35), width=cr9Width)
                crLines.push(current9HighLine)
                crLines.push(current9LowLine)
                if showCRTags and showLevelTags
                    crTags.push(label.new(hourTime, f_tagY(hourHigh, 1, 1.0), "9H", xloc=xloc.bar_time, yloc=yloc.price, style=f_labelStyle(cr9Marker, 1), color=f_labelBackground(cr9Marker, resolvedTagBackground), textcolor=cr9Color, size=f_tagSize(cr9TagSize), tooltip="9AM NY range; known after the candle closes at 10:00"))
                    crTags.push(label.new(hourTime, f_tagY(hourLow, -1, 1.0), "9L", xloc=xloc.bar_time, yloc=yloc.price, style=f_labelStyle(cr9Marker, -1), color=f_labelBackground(cr9Marker, resolvedTagBackground), textcolor=cr9Color, size=f_tagSize(cr9TagSize), tooltip="9AM NY range; known after the candle closes at 10:00"))
                if showCR9Open and not na(hourOpen)
                    current9OpenLine := line.new(hourTime, hourOpen, time_close, hourOpen, xloc=xloc.bar_time, extend=extend.right, color=color.new(cr9Color, 45), style=line.style_dotted, width=cr9Width)
                    crLines.push(current9OpenLine)
                    if showCRTags and showLevelTags
                        crTags.push(label.new(hourTime, f_tagY(hourOpen, 1, 1.25), "9O", xloc=xloc.bar_time, yloc=yloc.price, style=f_labelStyle(cr9Marker, 1), color=f_labelBackground(cr9Marker, resolvedTagBackground), textcolor=cr9Color, size=f_tagSize(cr9TagSize), tooltip="9AM NY candle open"))
        while crLines.size() > 80
            line.delete(crLines.shift())
        while crTags.size() > 80
            label.delete(crTags.shift())

    // First wick contact with each closed hourly range per NY day; no intrabar alerts.
    range8HighTap := not range8HighTouched and not na(cr8hi) and high >= cr8hi and low <= cr8hi
    range8LowTap := not range8LowTouched and not na(cr8lo) and high >= cr8lo and low <= cr8lo
    range9HighTap := not range9HighTouched and not na(cr9hi) and high >= cr9hi and low <= cr9hi
    range9LowTap := not range9LowTouched and not na(cr9lo) and high >= cr9lo and low <= cr9lo
    range8HighTouched := range8HighTouched or range8HighTap
    range8LowTouched := range8LowTouched or range8LowTap
    range9HighTouched := range9HighTouched or range9HighTap
    range9LowTouched := range9LowTouched or range9LowTap

string resolvedPanelPosition = panelPosition == "Top right" ? position.top_right : panelPosition == "Top left" ? position.top_left : panelPosition == "Bottom left" ? position.bottom_left : position.bottom_right
string resolvedPanelTextSize = panelSize == "Tiny" ? size.tiny : panelSize == "Normal" ? size.normal : size.small
string resolvedStatusSize = statusSize == "Tiny" ? size.tiny : statusSize == "Normal" ? size.normal : size.small
bool panelHasSignal = inspectMode == "Latest" ? checklistDirection != 0 : inspectedFound
int panelDirection = inspectMode == "Latest" ? checklistDirection : inspectedDirection
string panelKind = inspectMode == "Latest" ? checklistKind : inspectedKind
int panelSignalTime = inspectMode == "Latest" ? checklistTime : inspectedTime
int panelCount = inspectMode == "Latest" ? checklistCount : inspectedCount
string panelHtfSource = inspectMode == "Latest" ? checklistHtfSource : inspectedHtfSource
string panelDolSource = inspectMode == "Latest" ? checklistDolSource : inspectedDolSource
string panelModelTarget = inspectMode == "Latest" ? checklistModelTarget : inspectedModelTarget
var table panel = table.new(resolvedPanelPosition, 2, 16, border_width=1, border_color=panelBorder)
var table watermark = table.new(position.bottom_center, 1, 1)
if barstate.islast and watermarkOn
    table.cell(watermark, 0, 0, "LI Lab 0.28 EN\n" + syminfo.ticker + " / " + timeframe.period, text_color=panelText, bgcolor=panelBackground, text_size=size.tiny)
if barstate.islast and showChecklist
    table.cell(panel, 0, 0, "LI LAB 0.28 EN", text_color=color.orange, bgcolor=color.black, text_size=resolvedPanelTextSize)
    table.cell(panel, 1, 0, "CONFLUENCES", text_color=color.orange, bgcolor=color.black, text_size=resolvedPanelTextSize)
    table.cell(panel, 0, 1, inspectMode == "Latest" ? "Latest signal" : "Selected bar", text_color=panelText, bgcolor=panelBackground, text_size=resolvedPanelTextSize)
    table.cell(panel, 1, 1, panelKind, text_color=panelDirection == 1 ? bullColor : panelDirection == -1 ? bearColor : color.gray, bgcolor=panelBackground, text_size=resolvedPanelTextSize)
    table.cell(panel, 0, 2, "NY time", text_color=panelText, bgcolor=panelBackground, text_size=resolvedPanelTextSize)
    table.cell(panel, 1, 2, panelHasSignal ? str.format_time(panelSignalTime, "MM-dd HH:mm", zone) : "-", text_color=panelText, bgcolor=panelBackground, text_size=resolvedPanelTextSize)
    table.cell(panel, 0, 3, "Confluences", text_color=panelText, bgcolor=panelBackground, text_size=resolvedPanelTextSize)
    table.cell(panel, 1, 3, panelHasSignal ? str.tostring(panelCount) + "/8" : "-", text_color=metColor, bgcolor=panelBackground, text_size=resolvedPanelTextSize)
    array<string> names = array.from("Macro", "Setup sweep", "Linked delivery*", "Displacement/ATR*", "Session DOL*", "LTF DOL*", "V-window*", "SMT pivots*")
    for i = 0 to 7
        bool ok = inspectMode == "Latest" ? checklist.get(i) : inspectedChecklist.get(i)
        table.cell(panel, 0, i + 4, names.get(i), text_color=panelText, bgcolor=panelBackground, text_size=resolvedPanelTextSize)
        table.cell(panel, 1, i + 4, not panelHasSignal ? "-" : ok ? "↑" : "×", text_color=not panelHasSignal ? color.gray : ok ? metColor : unmetColor, bgcolor=panelBackground, text_size=resolvedStatusSize)
    table.cell(panel, 0, 12, "HTF source*", text_color=panelText, bgcolor=panelBackground, text_size=resolvedPanelTextSize)
    table.cell(panel, 1, 12, panelHasSignal ? panelHtfSource : "-", text_color=panelText, bgcolor=panelBackground, text_size=resolvedPanelTextSize)
    table.cell(panel, 0, 13, "Session DOL", text_color=panelText, bgcolor=panelBackground, text_size=resolvedPanelTextSize)
    table.cell(panel, 1, 13, panelHasSignal ? panelDolSource : "-", text_color=panelText, bgcolor=panelBackground, text_size=resolvedPanelTextSize)
    table.cell(panel, 0, 14, "Model DOL", text_color=panelText, bgcolor=panelBackground, text_size=resolvedPanelTextSize)
    table.cell(panel, 1, 14, panelHasSignal ? panelModelTarget : "-", text_color=panelText, bgcolor=panelBackground, text_size=resolvedPanelTextSize)
    table.cell(panel, 0, 15, "Laboratory criteria", text_color=color.gray, bgcolor=color.black, text_size=size.tiny)
    table.cell(panel, 1, 15, "Not a win rate", text_color=color.gray, bgcolor=color.black, text_size=size.tiny)

plot(showPriorDay ? priorDH : na, "Previous day high / PDH", color=priorLevelColor, linewidth=priorWidth, style=plot.style_stepline)
plot(showPriorDay ? priorDL : na, "Previous day low / PDL", color=priorLevelColor, linewidth=priorWidth, style=plot.style_stepline)
// These retrospective drawings start at their source hour. The ranges are only known
// after the hourly candle closes; alert calculations above are never backdated.
// dayOpen / weekOpen / priorWeekClose / monthOpen are requested with the prior-period levels above.
if barstate.isconfirmed and timeframe.change("W")
    if nwogBoxes.size() > 0
        box latestNwog = nwogBoxes.get(nwogBoxes.size() - 1)
        box.set_extend(latestNwog, extend.none)
        box.set_right(latestNwog, time)
    if showNWOG and not na(priorWeekClose) and not na(weekOpen) and math.abs(weekOpen - priorWeekClose) >= syminfo.mintick
        box weeklyGap = box.new(time, math.max(weekOpen, priorWeekClose), time_close, math.min(weekOpen, priorWeekClose), xloc=xloc.bar_time, extend=extend.right, border_color=nwogColor, bgcolor=color.new(nwogColor, 86), text="NWOG", text_color=nwogColor, text_size=size.tiny)
        nwogBoxes.push(weeklyGap)
        if nwogBoxes.size() > 8
            box.delete(nwogBoxes.shift())
plot(showDayOpen ? dayOpen : na, "Day open / DO", color=dayOpenColor, linewidth=dayWidth, style=plot.style_stepline)
plot(showWeekOpen ? weekOpen : na, "Week open / WO", color=weekOpenColor, linewidth=weekWidth, style=plot.style_stepline)
bool sameOpenEvent = showOpenTags and showDayOpen and showWeekOpen and timeframe.change("W") and math.abs(dayOpen - weekOpen) <= syminfo.mintick
// Keep viewport event labels inside a separate, bounded object pool.
bool eventVisible = time >= chart.left_visible_bar_time and time <= chart.right_visible_bar_time
if barstate.isconfirmed and eventVisible and eventTags.size() < 80
    if sameOpenEvent
        eventTags.push(label.new(bar_index, f_tagY(dayOpen, 1, 1.25), "DO/WO", yloc=yloc.price, style=f_labelStyle(dayMarker, 1), color=f_labelBackground(dayMarker, resolvedTagBackground), textcolor=dayOpenColor, size=f_tagSize(dayTagSize)))
    else
        if showOpenTags and showDayOpen and timeframe.change("D")
            eventTags.push(label.new(bar_index, f_tagY(dayOpen, 1, 1.25), "DO", yloc=yloc.price, style=f_labelStyle(dayMarker, 1), color=f_labelBackground(dayMarker, resolvedTagBackground), textcolor=dayOpenColor, size=f_tagSize(dayTagSize)))
        if showOpenTags and showWeekOpen and timeframe.change("W") and eventTags.size() < 80
            eventTags.push(label.new(bar_index, f_tagY(weekOpen, 1, 1.25), "WO", yloc=yloc.price, style=f_labelStyle(weekMarker, 1), color=f_labelBackground(weekMarker, resolvedTagBackground), textcolor=weekOpenColor, size=f_tagSize(weekTagSize)))
var array<label> referenceTags = array.new<label>()
var array<line> optionalReferenceLines = array.new<line>()
if barstate.islast
    for tag in referenceTags
        label.delete(tag)
    referenceTags.clear()
    for lineRef in optionalReferenceLines
        line.delete(lineRef)
    optionalReferenceLines.clear()
    int referenceStart = math.max(0, bar_index - 250)
    if showMonthOpen and not na(monthOpen)
        optionalReferenceLines.push(line.new(referenceStart, monthOpen, bar_index + openTagOffset, monthOpen, color=monthOpenColor, width=monthWidth))
    if showPriorWeek and not na(priorWH) and not na(priorWL)
        optionalReferenceLines.push(line.new(referenceStart, priorWH, bar_index + openTagOffset, priorWH, color=color.new(priorLevelColor, 20), width=priorWidth))
        optionalReferenceLines.push(line.new(referenceStart, priorWL, bar_index + openTagOffset, priorWL, color=color.new(priorLevelColor, 20), width=priorWidth))
    if showPriorMonth and not na(priorMH) and not na(priorML)
        optionalReferenceLines.push(line.new(referenceStart, priorMH, bar_index + openTagOffset, priorMH, color=color.new(priorLevelColor, 35), width=priorWidth))
        optionalReferenceLines.push(line.new(referenceStart, priorML, bar_index + openTagOffset, priorML, color=color.new(priorLevelColor, 35), width=priorWidth))
    if showOpenTags
        bool sameCurrentOpen = showDayOpen and showWeekOpen and math.abs(dayOpen - weekOpen) <= syminfo.mintick
        if sameCurrentOpen
            bool sameMonthOpen = showMonthOpen and math.abs(dayOpen - monthOpen) <= syminfo.mintick
            referenceTags.push(f_referenceTag(dayOpen, sameMonthOpen ? "DO / WO / MO" : "DO / WO", dayOpenColor))
        else
            if showDayOpen
                referenceTags.push(f_referenceTag(dayOpen, "DO", dayOpenColor))
            if showWeekOpen
                referenceTags.push(f_referenceTag(weekOpen, "WO", weekOpenColor))
        if showMonthOpen and (not sameCurrentOpen or math.abs(dayOpen - monthOpen) > syminfo.mintick)
            referenceTags.push(f_referenceTag(monthOpen, "MO", monthOpenColor))
    if showPriorTags
        if showPriorDay
            referenceTags.push(f_referenceTag(priorDH, "PDH", priorLevelColor))
            referenceTags.push(f_referenceTag(priorDL, "PDL", priorLevelColor))
        if showPriorWeek
            referenceTags.push(f_referenceTag(priorWH, "PWH", priorLevelColor))
            referenceTags.push(f_referenceTag(priorWL, "PWL", priorLevelColor))
        if showPriorMonth
            referenceTags.push(f_referenceTag(priorMH, "PMH", priorLevelColor))
            referenceTags.push(f_referenceTag(priorML, "PML", priorLevelColor))
// plotshape renders a historical series without consuming the finite label-object pool.
// Detailed labels replace the fixed marker on visible bars. The fixed series remains
// available on older bars and when the 250-label hover budget is exhausted.
plotshape(showSMT and smtHistoryMarkers and smtBull, "Confirmed bullish SMT vs peer", shape.labelup, location.belowbar, color(na), text="SMT", textcolor=color.rgb(20, 195, 142), size=size.tiny)
plotshape(showSMT and smtHistoryMarkers and smtBear, "Confirmed bearish SMT vs peer", shape.labeldown, location.abovebar, color(na), text="SMT", textcolor=color.rgb(255, 70, 78), size=size.tiny)
plotshape(signalsOn and allHistoryMarkers and not signalDetailDrawn and signalCode == 1, "C long history", shape.labelup, location.belowbar, color(na), text="C", textcolor=color.rgb(20, 195, 142), size=size.small)
plotshape(signalsOn and allHistoryMarkers and not signalDetailDrawn and signalCode == -1, "C short history", shape.labeldown, location.abovebar, color(na), text="C", textcolor=color.rgb(255, 70, 78), size=size.small)
plotshape(signalsOn and allHistoryMarkers and not signalDetailDrawn and signalCode == 2, "R long history", shape.labelup, location.belowbar, color(na), text="R", textcolor=color.rgb(20, 195, 142), size=size.small)
plotshape(signalsOn and allHistoryMarkers and not signalDetailDrawn and signalCode == -2, "R short history", shape.labeldown, location.abovebar, color(na), text="R", textcolor=color.rgb(255, 70, 78), size=size.small)
plotshape(signalsOn and allHistoryMarkers and not signalDetailDrawn and signalCode == 3, "R+ long history", shape.labelup, location.belowbar, color(na), text="R+", textcolor=color.rgb(20, 195, 142), size=size.small)
plotshape(signalsOn and allHistoryMarkers and not signalDetailDrawn and signalCode == -3, "R+ short history", shape.labeldown, location.abovebar, color(na), text="R+", textcolor=color.rgb(255, 70, 78), size=size.small)
// Stable machine-readable exports: 0 none; +/-1 C; +/-2 R; +/-3 R+.
plot(signalCode, "LAB signal code", display=display.data_window)
plot(sweepLong ? 1 : 0, "LAB sellside sweep", display=display.data_window)
plot(sweepShort ? 1 : 0, "LAB buyside sweep", display=display.data_window)
plot(signalZoneTop, "LAB model zone top", display=display.data_window)
plot(signalZoneBottom, "LAB model zone bottom", display=display.data_window)
plot(signalZoneTf, "LAB model zone minutes", display=display.data_window)
plot(signalSweepPrice, "LAB model sweep price", display=display.data_window)

