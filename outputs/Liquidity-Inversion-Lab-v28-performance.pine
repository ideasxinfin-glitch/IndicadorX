alertcondition(newBear1, "TF1 Bearish FVG Found", "LI Lab: closed TF1 bearish FVG")
alertcondition(newBull2, "TF2 Bullish FVG Found", "LI Lab: closed TF2 bullish FVG")
alertcondition(newBear2, "TF2 Bearish FVG Found", "LI Lab: closed TF2 bearish FVG")
alertcondition(newBull3, "4H Bullish FVG Found", "LI Lab: closed 4H bullish FVG")
alertcondition(newBear3, "4H Bearish FVG Found", "LI Lab: closed 4H bearish FVG")
alertcondition(touch1 and not touch1[1], "Price Tagged HTF1 FVG", "LI Lab: HTF1 contact")
alertcondition(touch2 and not touch2[1], "Price Tagged HTF2 FVG", "LI Lab: HTF2 contact")
alertcondition(touch3 and not touch3[1], "Price Tagged 4H FVG", "LI Lab: 4H contact")
alertcondition(mid1 and not mid1[1], "Price Crossed HTF1 FVG 50%", "LI Lab: HTF1 midpoint")
alertcondition(mid2 and not mid2[1], "Price Crossed HTF2 FVG 50%", "LI Lab: HTF2 midpoint")
alertcondition(mid3 and not mid3[1], "Price Crossed 4H FVG 50%", "LI Lab: 4H midpoint")
alertcondition(processLong and not processLong[1], "Possible Long (Inversing)", "LI Lab: long inversion process")
alertcondition(processShort and not processShort[1], "Possible Short (Inversing)", "LI Lab: short inversion process")
alertcondition(lrlBull, "Bullish LRL Formed", "LI Lab: bullish LRL hypothesis")
alertcondition(lrlBear, "Bearish LRL Formed", "LI Lab: bearish LRL hypothesis")
alertcondition(lrlBull or lrlBear, "LRL Formed", "LI Lab: LRL hypothesis")
alertcondition(smtBull, "Bullish SMT", "LI Lab: bullish SMT hypothesis")
alertcondition(smtBear, "Bearish SMT", "LI Lab: bearish SMT hypothesis")
alertcondition(smtBull or smtBear, "SMT Any", "LI Lab: SMT hypothesis")
alertcondition(sweepLong, "Liquidity Sweep Sellside", "LI Lab: sellside swept and reclaimed")
alertcondition(sweepShort, "Liquidity Sweep Buyside", "LI Lab: buyside swept and reclaimed")
alertcondition(signalCode == 3, "A+ Reversal Long", "LI Lab: experimental R+ long")
alertcondition(signalCode == -3, "A+ Reversal Short", "LI Lab: experimental R+ short")
alertcondition(signalCode >= 2, "Reversal Long", "LI Lab: experimental reversal long")
alertcondition(signalCode <= -2, "Reversal Short", "LI Lab: experimental reversal short")
alertcondition(signalCode == 1, "Continuation Long", "LI Lab: experimental continuation long")
alertcondition(signalCode == -1, "Continuation Short", "LI Lab: experimental continuation short")
alertcondition(signalCode > 0 and checklist.get(7), "Long + SMT", "LI Lab: experimental long with SMT")
alertcondition(signalCode < 0 and checklist.get(7), "Short + SMT", "LI Lab: experimental short with SMT")
alertcondition(range8HighTap, "8AM CR High Tap", "LI Lab: first confirmed wick contact with 8AM high")
alertcondition(range8LowTap, "8AM CR Low Tap", "LI Lab: first confirmed wick contact with 8AM low")
alertcondition(range9HighTap, "9AM CR High Tap", "LI Lab: first confirmed wick contact with 9AM high")
alertcondition(range9LowTap, "9AM CR Low Tap", "LI Lab: first confirmed wick contact with 9AM low")
alertcondition(londonSweptAsiaHigh, "London Swept Asia High", "LI Lab: London wick swept the prior Asia high")
alertcondition(londonSweptAsiaLow, "London Swept Asia Low", "LI Lab: London wick swept the prior Asia low")
alertcondition(nySweptAsiaHigh, "NY Swept Asia High", "LI Lab: New York wick swept the prior Asia high")
alertcondition(nySweptAsiaLow, "NY Swept Asia Low", "LI Lab: New York wick swept the prior Asia low")
alertcondition(nySweptLondonHigh, "NY Swept London High", "LI Lab: New York wick swept the prior London high")
