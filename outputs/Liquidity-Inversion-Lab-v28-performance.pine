string htf3TextSize = input.string("Tiny", "4h text size", options=["Tiny", "Small", "Normal"], group=G4, tooltip="Label size inside 4h FVGs.")
string zone = input.string("America/New_York", "Session timezone", group=G5, tooltip="Use America/New_York for the user's strategy windows.")
